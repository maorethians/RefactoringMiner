ine":43,"startLineOffset":96,"endLine":43,"endLineOffset":115,"length":20}]}]}]},{"groundTruth":{"original_line":116,"line":116,"comment_lines":["[][116]"],"review_comment":["Elsewhere in the code we use the convention of Count(1) - let\u0027s apply that here as well.","Hm, I tried to look for other places where `Count(1)` is used, but couldn\u0027t verify this (for ESQL at least).\r\n\r\nParsing `count()` results in `new Count(source, \"*\", KEYWORD)`, we also use the same in `Sum.surrogate()` and the (currently disabled) `NormalizeAggregate` used to replace all `count(literal)` by `count(*)` as well.\r\n\r\nFor consistency, I\u0027d like to stick to `count(*)` here."],"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/Count.java","id":37861,"created_at":"2024-04-22T07:13:53Z","original_position":55,"side":"RIGHT","position":55,"submitted_on_commit":"496a2448383e0316baf22f3f3605daee2061682f","diff_hunk":"@@ -87,4 +93,30 @@ public Nullability nullable() {\n     protected TypeResolution resolveType() {\n         return EsqlTypeResolutions.isExact(field(), sourceText(), DEFAULT);\n     }\n+\n+    @Override\n+    public Expression surrogate() {\n+        var s \u003d source();\n+        var field \u003d field();\n+\n+        if (field.foldable()) {\n+            if (field instanceof Literal l) {\n+                if (l.value() !\u003d null \u0026\u0026 (l.value() instanceof List\u003c?\u003e) \u003d\u003d false) {\n+                    // TODO: Normalize COUNT(*), COUNT(), COUNT(\"foobar\"), COUNT(1) as COUNT(*).\n+                    // Does not apply to COUNT([1,2,3])\n+                    // return new Count(s, new Literal(s, StringUtils.WILDCARD, DataTypes.KEYWORD));\n+                    return null;\n+                }\n+            }\n+\n+            // COUNT(const) is equivalent to MV_COUNT(const)*COUNT(*) if const is not null; otherwise COUNT(const) \u003d\u003d 0.\n+            return new Mul(\n+                s,\n+                new Coalesce(s, new MvCount(s, field), List.of(new Literal(s, 0, DataTypes.INTEGER))),\n+                new Count(s, new Literal(s, StringUtils.WILDCARD, DataTypes.KEYWORD))","submitted_line":116},"generatedCommentsNodes":[{"comment":"The implementation of `surrogate()` methods for `Count` and `CountDistinct` classes looks correct. However, the commented-out code in `Count.surrogate()` suggests that there are still some cases to handle (`COUNT(*)`, `COUNT()`, etc.). Ensure these cases are addressed in future changes.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/CountDistinct.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/CountDistinct.java--5928:6219","promptId":"#NFBQ1","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/CountDistinct.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/CountDistinct.java","srcChanges":[],"dstChanges":[{"pos":5928,"endPos":6219,"startLine":124,"startLineOffset":4,"endLine":132,"endLineOffset":5,"length":292}]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/Count.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/Count.java--1812:1831","promptId":"#97W15","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/Count.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/Count.java","srcChanges":[],"dstChanges":[{"pos":1812,"endPos":1831,"startLine":35,"startLineOffset":83,"endLine":35,"endLineOffset":102,"length":20}]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/Count.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression