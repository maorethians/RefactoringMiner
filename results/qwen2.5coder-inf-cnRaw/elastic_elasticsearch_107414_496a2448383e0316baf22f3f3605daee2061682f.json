eral(s, StringUtils.WILDCARD, DataTypes.KEYWORD));\n+                    return null;\n+                }\n+            }\n+\n+            // COUNT(const) is equivalent to MV_COUNT(const)*COUNT(*) if const is not null; otherwise COUNT(const) \u003d\u003d 0.\n+            return new Mul(\n+                s,\n+                new Coalesce(s, new MvCount(s, field), List.of(new Literal(s, 0, DataTypes.INTEGER))),\n+                new Count(s, new Literal(s, StringUtils.WILDCARD, DataTypes.KEYWORD))","submitted_line":116},"generatedCommentsNodes":[{"comment":"The logic for handling `COUNT(const)` could be simplified or clarified. The comment suggests a specific transformation, but the implementation uses a more complex structure involving `Mul`, `Coalesce`, and `MvCount`. This complexity might be necessary, but it should be documented or simplified if possible.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/Count.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/Count.java--3407:4400","promptId":"#0VTRR","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/Count.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/Count.java","srcChanges":[],"dstChanges":[{"pos":3407,"endPos":4400,"startLine":97,"startLineOffset":4,"endLine":121,"endLineOffset":5,"length":994}]}]},{"comment":"The logic for handling foldable fields and constants is introduced but not fully implemented or tested. For example, the TODO comment in `Count.java` suggests that normalization of different forms of COUNT() should be handled, but this is not addressed in the current changes. Additionally, while `CountDistinct` and `Median` have surrogate methods, they do not handle all cases comprehensively.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/funct