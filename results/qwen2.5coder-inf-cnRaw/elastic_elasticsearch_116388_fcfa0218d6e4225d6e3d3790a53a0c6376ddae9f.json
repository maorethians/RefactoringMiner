uitBreakerTests.java","dstPath":"x-pack/plugin/eql/src/test/java/org/elasticsearch/xpack/eql/execution/sequence/CircuitBreakerTests.java","srcChanges":[],"dstChanges":[{"pos":7521,"endPos":7536,"startLine":155,"startLineOffset":12,"endLine":155,"endLineOffset":27,"length":16},{"pos":7550,"endPos":7565,"startLine":156,"startLineOffset":12,"endLine":156,"endLineOffset":27,"length":16}]},{"id":"x-pack/plugin/eql/src/test/java/org/elasticsearch/xpack/eql/execution/sequence/PITFailureTests.java-x-pack/plugin/eql/src/test/java/org/elasticsearch/xpack/eql/execution/sequence/PITFailureTests.java--3975:3990,4008:4023","promptId":"#NFYEX","srcPath":"x-pack/plugin/eql/src/test/java/org/elasticsearch/xpack/eql/execution/sequence/PITFailureTests.java","dstPath":"x-pack/plugin/eql/src/test/java/org/elasticsearch/xpack/eql/execution/sequence/PITFailureTests.java","srcChanges":[],"dstChanges":[{"pos":3975,"endPos":3990,"startLine":86,"startLineOffset":16,"endLine":86,"endLineOffset":31,"length":16},{"pos":4008,"endPos":4023,"startLine":87,"startLineOffset":16,"endLine":87,"endLineOffset":31,"length":16}]}]}],"groundTruthGeneratedCommentsNodes":[{"groundTruth":{"original_line":75,"line":75,"comment_lines":["[][75]"],"review_comment":["Do we need a setting to tweak the default given it\u0027s a flag exposed at the request level? ","I\u0027m not completely sure tbh (maybe @yctercero has opinions here).\r\nMy thinking is that it could make our life easier on existing deployments, where we have hundreds of EQL rules already configured and we don\u0027t want to change them one by one, but maybe this can be addressed at higher level (in Kibana?).\r\n","@luigidellaquila is the discussion here about whether the partial results should be set to default true?\r\n\r\nI think it would make sense for them both be default to off and then at the Kibana level we can expose it as an advanced setting?\r\n\r\n@marshallmain @MikePaquette @approksiu what do you think?","Yes, all the defaults are to `false` now.\r\nThe discussion here was more about the real need for a cluster setting to change these defaults, since we can always set these values per query.","I\u0027m with @javanna here. If there is no need for this, let\u0027s not make it more complicated than it should be. If there will be a desire in the future for this, we can add it.\r\n\r\nThe basic principle of **\"it\u0027s easy to put stuff in, harder to take it out\"** (think about BWC) applies here.\r\n\r\nSame principle for having this as both **request parameter** and **request body parameter**: it complicates the logic unnecessarily and confuses users with a lot of options to think and reason about. I realize that ES query DSL has this in the same way (both **request parameter** and **request body parameter**) and I am not against this that much, but unless there is an actual need and request I wouldn\u0027t confuse users.","@yctercero I remember we discussed this off-line as an option, but I\u0027m not sure if you are actually planning to use these two cluster settings.\r\nShould we keep them?","Let\u0027s go with the less complicated option where we would handle it on the Kibana side - say an advanced setting or something of the like. \r\n\r\ncc @approksiu "],"path":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/EqlPlugin.java","id":36776,"created_at":"2024-11-27T08:21:13Z","original_position":16,"side":"RIGHT","position":16,"submitted_on_commit":"fcfa0218d6e4225d6e3d3790a53a0c6376ddae9f","diff_hunk":"@@ -60,6 +60,20 @@ public class EqlPlugin extends Plugin implements ActionPlugin, CircuitBreakerPlu\n         Setting.Property.DeprecatedWarning\n     );\n \n+    public static final Setting\u003cBoolean\u003e DEFAULT_ALLOW_PARTIAL_SEARCH_RESULTS \u003d Setting.boolSetting(\n+        \"xpack.eql.default_allow_partial_results\",\n+        false,\n+        Setting.Property.NodeScope,\n+        Setting.Property.Dynamic\n+    );\n+\n+    public static final Setting\u003cBoolean\u003e DEFAULT_ALLOW_PARTIAL_SEQUENCE_RESULTS \u003d Setting.boolSetting(\n+        \"xpack.eql.default_allow_partial_sequence_results\",\n+        false,\n+        Setting.Property.NodeScope,\n+        Setting.Property.Dynamic\n+    );","submitted_line":75},"generatedCommentsNodes":[{"comment":"These settings are correctly defined with appropriate properties (`NodeScope` and `Dynamic`). Ensure that these settings are properly documented and tested.","nodes":[{"id":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/EqlPlugin.java-x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/EqlPlugin.java--2897:3135","promptId":"#ERQ1H","srcPath":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/EqlPlugin.java","dstPath":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/EqlPlugin.java","srcChanges":[],"dstChanges":[{"pos":2897,"endPos":3135,"startLine":63,"startLineOffset":4,"endLine":68,"endLineOffset":6,"length":239}]},{"id":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/EqlPlugin.java-x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/EqlPlugin.java--3141:3390","promptId":"#VZWBY","srcPath":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/EqlPlugin.java","dstPath":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/EqlPlugin.java","srcChanges":[],"dstChanges":[{"pos":3141,"endPos":3390,"startLine":70,"startLineOffset":4,"endLine":75,"endLineOffset":6,"length":250}]}]}]}],"coveredGroundTruth":1,"uncoveredGroundTruth":0,"coveredMatchable":37,"uncoveredMatchable":92,"timing":70316,"tokensIn":17939,"tokensOut":1795}