574,"startLine":97,"startLineOffset":12,"endLine":97,"endLineOffset":74,"length":63},{"pos":3587,"endPos":3618,"startLine":98,"startLineOffset":12,"endLine":98,"endLineOffset":43,"length":32}]}]},{"comment":"The method `ordinalAttributes` has been introduced and used to determine which attributes can be loaded from ordinals. Ensure that the logic correctly identifies these attributes and that it does not inadvertently include or exclude any attributes. The refactoring should maintain the integrity of the plan\u0027s output.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/InsertFieldExtraction.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/InsertFieldExtraction.java-2398:2459,2479:2539,2556:3156-2292:2322,2342:2390,2407:2468","promptId":"#ZM69J","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/InsertFieldExtraction.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/InsertFieldExtraction.java","srcChanges":[{"pos":2398,"endPos":2459,"startLine":57,"startLineOffset":16,"endLine":57,"endLineOffset":77,"length":62},{"pos":2479,"endPos":2539,"startLine":58,"startLineOffset":16,"endLine":58,"endLineOffset":76,"length":61},{"pos":2556,"endPos":3156,"startLine":59,"startLineOffset":16,"endLine":68,"endLineOffset":17,"length":601}],"dstChanges":[{"pos":2292,"endPos":2322,"startLine":55,"startLineOffset":16,"endLine":55,"endLineOffset":46,"length":31},{"pos":2342,"endPos":2390,"startLine":56,"startLineOffset":16,"endLine":56,"endLineOffset":64,"length":49},{"pos":2407,"endPos":2468,"startLine":57,"startLineOffset":16,"endLine":57,"endLineOffset":77,"length":62}]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/physical/AggregateExec.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/physical/AggregateExec.ja