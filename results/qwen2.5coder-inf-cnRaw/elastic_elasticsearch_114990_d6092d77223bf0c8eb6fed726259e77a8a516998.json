in/java/org/elasticsearch/index/query/CoordinatorRewriteContextProvider.java","dstPath":"server/src/main/java/org/elasticsearch/index/query/CoordinatorRewriteContextProvider.java","srcChanges":[],"dstChanges":[{"pos":3571,"endPos":3675,"startLine":78,"startLineOffset":12,"endLine":78,"endLineOffset":116,"length":105}]},{"id":"test/framework/src/main/java/org/elasticsearch/test/AbstractBuilderTestCase.java-test/framework/src/main/java/org/elasticsearch/test/AbstractBuilderTestCase.java--28721:28723","promptId":"#KJEMN","srcPath":"test/framework/src/main/java/org/elasticsearch/test/AbstractBuilderTestCase.java","dstPath":"test/framework/src/main/java/org/elasticsearch/test/AbstractBuilderTestCase.java","srcChanges":[],"dstChanges":[{"pos":28721,"endPos":28723,"startLine":634,"startLineOffset":122,"endLine":634,"endLineOffset":124,"length":3}]}]}],"groundTruthGeneratedCommentsNodes":[{"groundTruth":{"original_line":78,"line":84,"comment_lines":["[][84]"],"review_comment":["We are potentially artificially limiting the coordinator tier rewrite to [only indices that have the time range configured](https://github.com/elastic/elasticsearch/pull/114990/files#diff-0ad1800461d83a801b07a1207f4395615a0e9b6b5aad9ded33bda88e0f784d47R56) (partially mounted indices). We don\u0027t have to have this limitation for the `_tier` coordination rewrite however, the current implementation is sufficient for skipping frozen (where all indices do indeed have the `@timestamp` and `event.ingested` ranges). \r\n\r\nIn the interest of keeping this fix targeted and contained I believe it\u0027s a good compromise for now but curious what you think.","That\u0027s quite subtle, is that because above we return null if the range field info isn\u0027t found in the cluster state? \r\n\r\n```\r\nDateFieldRangeInfo dateFieldRangeInfo \u003d mappingSupplier.apply(index);\r\nif (dateFieldRangeInfo \u003d\u003d null) {\r\n    return null;\r\n}\r\n```\r\n\r\nI think this is ok, but perhaps let\u0027s clarify in the code that it\u0027s by design and not by mistake? Perhaps we will want to extend this in the future to all indices? I mean there is no technical reason that this tier filtering cannot be extended to all indices, provided that the tier field cannot ever change (which may happen for some constant field types - e.g. they may be unset and get set for the first time via dynamic mappings)","now that this is merged, do we want to do the follow-up to allow filtering on tier to work on all indices?","Yes, PR is up https://github.com/elastic/elasticsearch/pull/115797"],"path":"server/src/main/java/org/elasticsearch/index/query/CoordinatorRewriteContextProvider.java","id":35575,"created_at":"2024-10-18T13:57:48Z","original_position":6,"side":"RIGHT","position":19,"submitted_on_commit":"d6092d77223bf0c8eb6fed726259e77a8a516998","diff_hunk":"@@ -74,7 +74,8 @@ public CoordinatorRewriteContext getCoordinatorRewriteContext(Index index) {\n             parserConfig,\n             client,\n             nowInMillis,\n-            new DateFieldRangeInfo(timestampFieldType, timestampRange, dateFieldRangeInfo.eventIngestedFieldType(), eventIngestedRange)\n+            new DateFieldRangeInfo(timestampFieldType, timestampRange, dateFieldRangeInfo.eventIngestedFieldType(), eventIngestedRange),\n+            indexMetadata.getTierPreference().isEmpty() \u003d\u003d false ? indexMetadata.getTierPreference().getFirst() : \"\"","submitted_line":78},"generatedCommentsNodes":[{"comment":"The constructor of `CoordinatorRewriteContext` now includes a `tier` parameter. Ensure that all instances of `CoordinatorRewriteContext` are properly initialized with this new parameter, and that it does not introduce any null pointer exceptions or other issues.","nodes":[{"id":"server/src/main/java/org/elasticsearch/index/query/CoordinatorRewriteContext.java-server/src/main/java/org/elasticsearch/index/query/CoordinatorRewriteContext.java--2321:2332,2748:2765","promptId":"#RR9V6","srcPath":"server/src/main/j