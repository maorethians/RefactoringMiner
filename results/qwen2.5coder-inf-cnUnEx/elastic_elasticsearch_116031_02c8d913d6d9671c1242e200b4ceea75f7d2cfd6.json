tartLineOffset":8,"endLine":292,"endLineOffset":11,"length":198},{"pos":14175,"endPos":14416,"startLine":293,"startLineOffset":8,"endLine":295,"endLineOffset":49,"length":242},{"pos":14426,"endPos":14540,"startLine":297,"startLineOffset":8,"endLine":297,"endLineOffset":122,"length":115},{"pos":14549,"endPos":14601,"startLine":298,"startLineOffset":8,"endLine":298,"endLineOffset":60,"length":53},{"pos":14610,"endPos":14787,"startLine":299,"startLineOffset":8,"endLine":303,"endLineOffset":9,"length":178},{"pos":14796,"endPos":14851,"startLine":304,"startLineOffset":8,"endLine":304,"endLineOffset":63,"length":56},{"pos":14860,"endPos":14898,"startLine":305,"startLineOffset":8,"endLine":305,"endLineOffset":46,"length":39}],"dstChanges":[{"pos":13889,"endPos":14113,"startLine":285,"startLineOffset":8,"endLine":288,"endLineOffset":9,"length":225}]},{"id":"server/src/main/java/org/elasticsearch/action/bulk/TransportAbstractBulkAction.java-server/src/main/java/org/elasticsearch/action/bulk/TransportAbstractBulkAction.java-12182:12273-11985:12062,12268:12817","promptId":"#W982J","srcPath":"server/src/main/java/org/elasticsearch/action/bulk/TransportAbstractBulkAction.java","dstPath":"server/src/main/java/org/elasticsearch/action/bulk/TransportAbstractBulkAction.java","srcChanges":[{"pos":12182,"endPos":12273,"startLine":234,"startLineOffset":16,"endLine":234,"endLineOffset":107,"length":92}],"dstChanges":[{"pos":11985,"endPos":12062,"startLine":231,"startLineOffset":8,"endLine":231,"endLineOffset":85,"length":78},{"pos":12268,"endPos":12817,"startLine":235,"startLineOffset":16,"endLine":242,"endLineOffset":17,"length":550}]}]},{"comment":"The `resolvePipelinesAndUpdateIndexRequest` method is now a wrapper around `resolveStoredPipelines` and `setPipelineOnRequest`. Ensure that all existing calls to this method are reviewed to confirm they align with the new logic, especially regarding the pipeline resolution process.","nodes":[{"id":"server/src/main/java/org/elasticsearch/ingest/IngestService.java-server/src/main/java/org/elasticsearch/ingest/IngestService.java-13889:13959,13969:14166,14175:14416,14426:14540,14549:14601,14610:14787,14796:14851,14860:14898-13889:14113","promptId":"#0W1GC","srcPath":"server/src/main/java/org/elasticsearch/ingest/IngestService.java","dstPath":"server/src/main/java/org/elasticsearch/ingest/IngestService.java","srcChanges":[{"pos":13889,"endPos":13959,"startLine":285,"startLineOffset":8,"endLine":287,"endLineOffset":9,"length":71},{"pos":13969,"endPos":14166,"startLine":289,"startLineOffset":8,"endLine":292,"endLineOffset":11,"length":198},{"pos":14175,"endPos":14416,"startLine":293,"startLineOffset":8,"endLine":295,"endLineOffset":49,"length":242},{"pos":14426,"endPos":14540,"startLine":297,"startLineOffset":8,"endLine":297,"endLineOffset":122,"length":115},{"pos":14549,"endPos":14601,"startLine":298,"startLineOffset":8,"endLine":298,"endLineOffset":60,"length":53},{"pos":14610,"endPos":14787,"startLine":299,"startLineOffset":8,"endLine":303,"endLineOffset":9,"length":178},{"pos":14796,"endPos":14851,"startLine":304,"startLineOffset":8,"endLine":304,"endLineOffset":63,"length":56},{"pos":14860,"endPos":14898,"startLine":305,"startLineOffset":8,"endLine":305,"endLineOffset":46,"length":39}],"dstChanges":[{"pos":13889,"endPos":14113,"startLine":285,"startLineOffset":8,"endLine":288,"endLineOffset":9,"length":225}]},{"id":"server/src/main/java/org/elasticsearch/action/bulk/TransportAbstractBulkAction.java-server/src/main/java/org/elasticsearch/action/bulk/TransportAbstractBulkAction.java-12182:12273-11985:12062,12268:12817","promptId":"#W982J","srcPath":"server/src/main/java/org/elasticsearch/action/bulk/TransportAbstractBulkAction.java","dstPath":"server/src/main/java/org/elasticsearch/action/bulk/TransportAbstractBulkAction.java","srcChanges":[{"pos":12182,"endPos":12273,"startLine":234,"startLineOffset":16,"endLine":234,"endLineOffset":107,"length":92}],"dstChanges":[{"pos":11985,"endPos":12062,"startLine":231,"startLineOffset":8,"endLine":231,"endLineOffset":85,"length":78},{"pos":12268,"endPos":12817,"startLine":235,"startLineOffset":16,"endLine":242,"endLineOffset":17,"length":550}]}]},{"comment":"The tests added for `isRolloverOnWrite` and `testResolveFromTemplateIfRolloverOnWrite` cover various scenarios but could benefit from additional edge cases. For example, test scenarios where the index or data stream does not exist in metadata.","nodes":[{"id":"server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java-server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java--132154:135516","promptId":"#0AFYP","srcPath":"server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java","dstPath":"server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java","srcChanges":[],"dstChanges":[{"pos":132154,"endPos":135516,"startLine":2556,"startLineOffset":4,"endLine":2625,"endLineOffset":5,"length":3363}]},{"id":"server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java-server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java--130053:132148","promptId":"#FH11Z","srcPath":"server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java","dstPath":"server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java","srcChanges":[],"dstChanges":[{"pos":130053,"endPos":132148,"startLine":2510,"startLineOffset":4,"endLine":2554,"endLineOffset":5,"length":2096}]}]}],"groundTruthGeneratedCommentsNodes":[{"groundTruth":{"original_line":234,"line":234,"comment_lines":["[234][]"],"review_comment":["I am been having trouble unit testing this bit of code that does caching because it\u0027s inlined in the loop. I\u0027m not super worried, because it is very similar to ` resolvePipelinesAndUpdateIndexRequest()` which is tested well (but doesn\u0027t do the caching).\r\n\r\nWe discussed previously (and discarded) some ideas for encapsulating this logic so it could be tested. Eg, having `resolvePipelinesAndUpdateIndexRequest` take a reference to `resolvedPipelineCache`, but that was decidedly nasty.\r\n\r\nThe only other idea I have, it to encapsulate the `resolvedPipelineCache` map in an class called `CachedPipelineResolver` with a function `resolvePipelinesAndUpdateIndexRequest` consisting of the lines of logic below.\r\n\r\nThoughts?","This is what I meant:\r\n```\r\n   public static class CachedPipelineResolver {\r\n        private final Map\u003cString, Pipelines\u003e resolvedPipelineCache;\r\n\r\n        public CachedPipelineResolver() {\r\n            this(new HashMap\u003c\u003e());\r\n        }\r\n\r\n        // For testing\r\n        CachedPipelineResolver(Map\u003cString, Pipelines\u003e resolvedPipelineCache) {\r\n            this.resolvedPipelineCache \u003d resolvedPipelineCache;\r\n        }\r\n\r\n        public void resolvePipelinesAndUpdateIndexRequest(\r\n            final DocWriteRequest\u003c?\u003e originalRequest,\r\n            final IndexRequest indexRequest,\r\n            final Metadata metadata\r\n        ) {\r\n            if (indexRequest.isPipelineResolved() \u003d\u003d false) {\r\n                var pipeline \u003d resolvedPipelineCache.computeIfAbsent(\r\n                    indexRequest.index(),\r\n                    // TODO perhaps this should use `threadPool.absoluteTimeInMillis()`, but leaving as is for now.\r\n                    (index) -\u003e IngestService.resolveStoredPipelines(originalRequest, indexRequest, metadata, System.currentTimeMillis())\r\n                );\r\n                IngestService.setPipelineOnRequest(indexRequest, pipeline);\r\n            }\r\n        }\r\n    \r\n```","If y\u0027all like this approach, I have an un-pushed commit with this change and more unit tests.","I don\u0027t have strong feelings either way.","I\u0027m in favor of that version of the code (or something not entirely unlike it), and I think it resolves my issues about how intimate these two classes are getting with each other. Given the plan for backporting this PR, I think we should punt on that change until a subsequent PR.\r\n\r\nThat is, let\u0027s merge this PR more or less as-is to all the branches, but then we can follow up with a separate refactoring PR for `main` and `8.x` only next week."],"path":"server/src/main/java/org/elasticsearch/action/bulk/TransportAbstractBulkAction.java","id":37689,"created_at":"2024-11-01T14:48:56Z","original_position":8,"side":"LEFT","position":8,"submitted_on_commit":"02c8d913d6d9671c1242e200b4ceea75f7d2cfd6","diff_hunk":"@@ -228,10 +228,18 @@ private boolean applyPipelines(Task task, BulkRequest bulkRequest, Executor exec\n             metadata \u003d clusterService.state().getMetadata();\n         }\n \n+        Map\u003cString, IngestService.Pipelines\u003e resolvedPipelineCache \u003d new HashMap\u003c\u003e();\n         for (DocWriteRequest\u003c?\u003e actionRequest : bulkRequest.requests) {\n             IndexRequest indexRequest \u003d getIndexWriteRequest(actionRequest);\n             if (indexRequest !\u003d null) {\n-                IngestService.resolvePipelinesAndUpdateIndexRequest(actionRequest, indexRequest, metadata);","submitted_line":234},"generatedCommentsNodes":[{"comment":"The `resolveStoredPipelines` method first checks if rollover is on write and resolves pipelines from index templates in that case. If not, it attempts to resolve from metadata and falls back to templates. This logic seems correct but could be made clearer by adding comments explaining the rationale behind checking rollover before metadata.","nodes":[{"id":"server/src/main/java/org/elasticsearch/ingest/IngestService.java-server/src/main/java/org/elasticsearch/ingest/IngestService.java-13889:13959,13969:14166,14175:14416,14426:14540,14549:14601,14610:14787,14796:14851,14860:14898-13889:14113","promptId":"#0W1GC","srcPath":"server/src/main/java/org/elasticsearch/ingest/IngestService.java","dstPath":"server/src/main/java/org/elasticsearch/ingest/IngestService.java","srcChanges":[{"po