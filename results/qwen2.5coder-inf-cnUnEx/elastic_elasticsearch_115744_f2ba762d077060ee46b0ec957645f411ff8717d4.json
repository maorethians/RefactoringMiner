et":80,"endLine":32,"endLineOffset":94,"length":15},{"pos":1472,"endPos":1502,"startLine":33,"startLineOffset":19,"endLine":33,"endLineOffset":49,"length":31},{"pos":1506,"endPos":1526,"startLine":33,"startLineOffset":53,"endLine":33,"endLineOffset":73,"length":21},{"pos":1527,"endPos":1531,"startLine":33,"startLineOffset":74,"endLine":33,"endLineOffset":78,"length":5}],"dstChanges":[{"pos":2269,"endPos":2952,"startLine":47,"startLineOffset":4,"endLine":54,"endLineOffset":7,"length":684},{"pos":2957,"endPos":2964,"startLine":55,"startLineOffset":4,"endLine":55,"endLineOffset":11,"length":8},{"pos":3096,"endPos":3117,"startLine":56,"startLineOffset":80,"endLine":56,"endLineOffset":101,"length":22},{"pos":3144,"endPos":3219,"startLine":57,"startLineOffset":19,"endLine":57,"endLineOffset":94,"length":76},{"pos":3223,"endPos":3243,"startLine":57,"startLineOffset":98,"endLine":57,"endLineOffset":118,"length":21}]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java-606:611-","promptId":"#ACS0E","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java","srcChanges":[{"pos":606,"endPos":611,"startLine":17,"startLineOffset":0,"endLine":17,"endLineOffset":5,"length":6}],"dstChanges":[]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java-638:1080-","promptId":"#MSJ48","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java","srcChanges":[{"pos":638,"endPos":1080,"startLine":18,"startLineOffset":4,"endLine":25,"endLineOffset":5,"length":443}],"dstChanges":[]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java-612:631-","promptId":"#XGNWT","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java","srcChanges":[{"pos":612,"endPos":631,"startLine":17,"startLineOffset":6,"endLine":17,"endLineOffset":25,"length":20}],"dstChanges":[]}]}],"groundTruthGeneratedCommentsNodes":[{"groundTruth":{"original_line":29,"line":29,"comment_lines":["[][29]"],"review_comment":["Do we still need the default implementation ? I wonder how out of sync it will become with respect to SearchStats.\r\n\r\nSeparately there\u0027s a lot in this class - it defines both an interface, its implementations and acts as a factory so I suggest decomposing it:\r\n1. have FieldAttribute in the name since all methods resolve around that - e.g. LucenePushDown, LuceneFieldInfo,  etc...\r\n2. Move the two implementation into a Xs class such as LucenePushDowns, LuceneFieldInfos,  (like we do for DataType and DataTypes) :  LucenePushDowns.DEFAULT or LucenePushDowns.from(SearchStats)\r\n","The recent work on MATCH has removed one of the three usages of the DEFAULT implementation. One other is test-only so could be refactored away, but the remaining use persists. It is in the `ComputeEngine.startComputeOnDataNodes` method, which creates a filter on `@timestamp` based on the current plan before we even know the separate data nodes, or individual SearchExecutionContexts to be used for creating the `SearchStats`. I\u0027m maintaining the exact same behaviour here (ie. I did not want to change anything here, other than naming), although perhaps we would want to revisit this later. If so, we should do that in another PR.\r\n\r\n(The above mentioned test-only usage is in `FilterTests`, but if we got rid of the ComputeEngine usage, we could mock SearchStats in FilterTests to get around that usage too, again a task for another PR if we desire it).\r\n\r\nRegarding splitting the file into multiple files, I actually prefer the current approach because it is a simple interface with two simple implementations, and I think it is much easier to reason about with all three in the same file (which remains a very small file)."],"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java","id":36390,"created_at":"2024-11-08T05:40:17Z","original_position":29,"side":"RIGHT","position":29,"submitted_on_commit":"f2ba762d077060ee46b0ec957645f411ff8717d4","diff_hunk":"@@ -0,0 +1,111 @@\n+/*\n+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one\n+ * or more contributor license agreements. Licensed under the Elastic License\n+ * 2.0; you may not use this file except in compliance with the Elastic License\n+ * 2.0.\n+ */\n+\n+package org.elasticsearch.xpack.esql.optimizer.rules.physical.local;\n+\n+import org.elasticsearch.xpack.esql.core.expression.Expression;\n+import org.elasticsearch.xpack.esql.core.expression.FieldAttribute;\n+import org.elasticsearch.xpack.esql.core.type.DataType;\n+import org.elasticsearch.xpack.esql.stats.SearchStats;\n+\n+/**\n+ * When deciding if a filter or topN can be pushed down to Lucene, we need to check a few things on the field.\n+ * Exactly what is checked depends on the type of field and the query. For example, we have the following possible combinations:\n+ * \u003col\u003e\n+ *     \u003cli\u003eA normal filter on a normal field will be pushed down using SingleValueQuery to remove multi-valued results,\n+ *         and this requires knowing if the field is indexed and has doc-values.\u003c/li\u003e\n+ *     \u003cli\u003eA filter using a spatial function will allow multi-valued fields and we only need to know if the field is indexed,\n+ *         and do not need doc values.\u003c/li\u003e\n+ *     \u003cli\u003eA TopN will be pushed down if the field is indexed and has doc values.\u003c/li\u003e\n+ *     \u003cli\u003eFilters with TEXT fields can only be pushed down if the TEXT field has a nested KEYWORD field,\n+ *         referred to here as IdenticalDelegate. This that this is related to normal ES|QL predicates,\n+ *         not the full-text search provided by the MATCH and QSTR functions, which are pushed down separately.\u003c/li\u003e\n+ * \u003c/ol\u003e\n+ */\n+public interface LucenePushdownPredicates {","submitted_line":29},"generatedCommentsNodes":[{"comment":"The introduction of `LucenePushdownPredicates` is a good step towards making the code more flexible and testable. However, ensure that all implementations of this interface are consistent with the expected behavior.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java--1630:1639","promptId":"#CSJ0N","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java","srcChanges":[],"dstChanges":[{"pos":1630,"endPos":1639,"startLine":29,"startLineOffset":7,"endLine":29,"endLineOffset":16,"length":10}]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java--568:1622","promptId":"#KR8VF","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java","srcChanges":[],"dstChanges":[{"pos":568,"endPos":1622,"startLine":15,"startLineOffset":0,"endLine":28,"endLineOffset":3,"length":1055}]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java--1640:1664","promptId":"#X2AYY","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java","srcChanges":[],"dstChanges":[{"pos":1640,"endPos":1664,"startLine":29,"startLineOffset":17,"endLine":29,"endLineOffset":41,"length":25}]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java--1623:1629","promptId":"#G02KC","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushDownUtils.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/rules/physical/local/LucenePushdownPredicates.java","srcChanges":[],"dstChanges":[{"pos":1623,"endPos":1629,"startLine":29,"startLineOffset":0,"endLine":29,"endLineOffset":6,"length":7}]}]}