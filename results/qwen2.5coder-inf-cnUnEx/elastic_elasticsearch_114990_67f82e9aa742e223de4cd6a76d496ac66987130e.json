","original_position":63,"side":"RIGHT","position":123,"submitted_on_commit":"67f82e9aa742e223de4cd6a76d496ac66987130e","diff_hunk":"@@ -99,4 +108,8 @@ public IndexLongFieldRange getFieldRange(String fieldName) {\n     public CoordinatorRewriteContext convertToCoordinatorRewriteContext() {\n         return this;\n     }\n+\n+    public String tier() {\n+        return tier;\n+    }","submitted_line":114},"generatedCommentsNodes":[]}],"coveredGroundTruth":0,"uncoveredGroundTruth":1,"coveredMatchable":27,"uncoveredMatchable":37,"timing":71723,"tokensIn":17430,"tokensOut":967}