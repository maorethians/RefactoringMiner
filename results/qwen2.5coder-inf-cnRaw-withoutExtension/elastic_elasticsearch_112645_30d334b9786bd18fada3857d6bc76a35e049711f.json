":71,"endLine":204,"endLineOffset":92,"length":22},{"pos":8000,"endPos":8014,"startLine":205,"startLineOffset":38,"endLine":205,"endLineOffset":52,"length":15},{"pos":8037,"endPos":8083,"startLine":206,"startLineOffset":20,"endLine":206,"endLineOffset":66,"length":47},{"pos":8104,"endPos":8464,"startLine":207,"startLineOffset":20,"endLine":212,"endLineOffset":21,"length":361},{"pos":8485,"endPos":8546,"startLine":213,"startLineOffset":20,"endLine":213,"endLineOffset":81,"length":62},{"pos":8567,"endPos":8579,"startLine":214,"startLineOffset":20,"endLine":214,"endLineOffset":32,"length":13}]},{"id":"server/src/main/java/org/elasticsearch/index/mapper/TimeSeriesIdFieldMapper.java-server/src/main/java/org/elasticsearch/index/mapper/TimeSeriesIdFieldMapper.java-6735:6799-","promptId":"#KKHX0","srcPath":"server/src/main/java/org/elasticsearch/index/mapper/TimeSeriesIdFieldMapper.java","dstPath":"server/src/main/java/org/elasticsearch/index/mapper/TimeSeriesIdFieldMapper.java","srcChanges":[{"pos":6735,"endPos":6799,"startLine":178,"startLineOffset":8,"endLine":178,"endLineOffset":72,"length":65}],"dstChanges":[]}]}]},{"groundTruth":{"original_line":404,"line":406,"comment_lines":["[][406]"],"review_comment":["Do I understand correctly that the hash here depends on the order the fields get hashed? I wonder if we have issues if the fields get shuffled, i.e. `\"foo\": { \"a\": [1,2,3], \"b\": 10  }` and `\"foo\": { \"b\": 10, \"a\": [1,2,3] }` need to give the same hash.","No, the hashes get sorted by the field name, so the hash is consistent, regardless of the ordering of fields in the source. Where ordering matters is within arrays. This is why in the `compare to` method in `NameAndHash`, we\u0027re primarily sorting by the name, and the order is just the tie breaker, which only affects arrays, as that\u0027s the only way you can have two `NameAndHash` instances with the same name. This is also tested in `org.elasticsearch.cluster.routing.IndexRoutingTests#testRoutingPathArraysInSource`."],"path":"server/src/main/java/org/elasticsearch/cluster/routing/IndexRouting.java","id":36665,"created_at":"2024-09-13T08:07:57Z","original_position":47,"side":"RIGHT","position":88,"submitted_on_commit":"30d334b9786bd18fada3857d6bc76a35e049711f","diff_hunk":"@@ -402,6 +400,10 @@ private void extractItem(String path, XContentParser source) throws IOException\n                 }\n             }\n \n+            private void addHash(String path, BytesRef value) {\n+                hashes.add(new NameAndHash(new BytesRef(path), hash(value), hashes.size()));","submitted_line":404},"generatedCommentsNodes":[{"comment":"Refactoring to use `addHash` method improves code readability and reduces duplication. Ensure that all paths in `extractItem` and `addMatching` are covered by tests.","nodes":[{"id":"server/src/main/java/org/elasticsearch/cluster/routing/IndexRouting.java-server/src/main/java/org/elasticsearch/cluster/routing/IndexRouting.java-13076:13085,13093:13099-13446:13473","promptId":"#HRSCW","srcPath":"server/src/main/java/org/elasticsearch/cluster/routing/IndexRouting.java","dstPath":"server/src/main/java/org/elasticsearch/cluster/routing/IndexRouting.java","srcChanges":[{"pos":13076,"endPos":13085,"startLine":338,"startLineOffset":60,"endLine":338,"endLineOffset":69,"length":10},{"pos":13093,"endPos":13099,"startLine":338,"startLineOffset":77,"endLine":338,"endLineOffset":83,"length":7}],"dstChanges":[{"pos":13446,"endPos":13473,"startLine":345,"startLineOffset":20,"endLine":345,"endLineOffset":47,"length":28}]},{"id":"server/src/main/java/org/elasticsearch/cluster/routing/IndexRouting.java-server/src/main/java/org/elasticsearch/cluster/routing/IndexRouting.java--16026:16184","promptId":"#WWKY7","srcPath":"server/src/main/java/org/elasticsearch/cluster/routing/IndexRouting.java","dstPath":"server/src/main/java/org/elasticsearch/cluster/routing/IndexRouting.java","srcChanges":[],"dstChanges":[{"pos":16026,"endPos":16184,"startLine":403,"startLine