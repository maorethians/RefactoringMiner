dFieldMapperTests.java","srcChanges":[],"dstChanges":[{"pos":32041,"endPos":32932,"startLine":655,"startLineOffset":4,"endLine":668,"endLineOffset":5,"length":892}]}]}],"groundTruthGeneratedCommentsNodes":[{"groundTruth":{"original_line":389,"line":389,"comment_lines":["[][389]"],"review_comment":["In the multi valued case, do you often expect 4 ip values?","This is assuming that when there are multiple values, we\u0027ll likely have less than 10 (the default size for ArrayLists), but probably more than 2."],"path":"server/src/main/java/org/elasticsearch/index/mapper/TimeSeriesIdFieldMapper.java","id":36666,"created_at":"2024-09-13T11:28:34Z","original_position":110,"side":"RIGHT","position":109,"submitted_on_commit":"30d334b9786bd18fada3857d6bc76a35e049711f","diff_hunk":"@@ -367,8 +377,20 @@ public DocumentDimensions validate(final IndexSettings settings) {\n         }\n \n         private void add(String fieldName, BytesReference encoded) throws IOException {\n-            if (dimensions.add(new Dimension(new BytesRef(fieldName), encoded)) \u003d\u003d false) {\n-                throw new IllegalArgumentException(\"Dimension field [\" + fieldName + \"] cannot be a multi-valued field.\");\n+            BytesRef name \u003d new BytesRef(fieldName);\n+            List\u003cBytesReference\u003e values \u003d dimensions.get(name);\n+            if (values \u003d\u003d null) {\n+                // optimize for the common case where dimensions are not multi-valued\n+                dimensions.put(name, List.of(encoded));\n+            } else {\n+                if (values.size() \u003d\u003d 1) {\n+                    // converts the immutable list that\u0027s optimized for the common case of having only one value to a mutable list\n+                    BytesReference previousValue \u003d values.get(0);\n+                    values \u003d new ArrayList\u003c\u003e(4);","submitted_line":389},"generatedCommentsNodes":[{"comment":"The changes related to handling multi-value