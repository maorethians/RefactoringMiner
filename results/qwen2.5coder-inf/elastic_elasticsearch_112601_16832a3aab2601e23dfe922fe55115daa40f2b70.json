Mv();\n            add.flushRemaining();\n            assertThat(counter.count, equalTo(Integer.MAX_VALUE / 5 + 1));\n        }\n    }","nodeType":"ADDITION","treeType":"MethodDeclaration","descendantSimpleNames":["Integer","MAX_VALUE","testMvBillions","CountingAddInput","counter","CountingAddInput","AddPage","add","AddPage","blockFactory","counter","i","i","i","add","appendOrdInMv","assertThat","add","added","equalTo","i","i","assertThat","equalTo","i","i","logger","info","String","format","i","add","finishMv","add","appendOrdInMv","assertThat","add","added","equalTo","add","appendOrdInMv","assertThat","add","added","equalTo","add","finishMv","add","flushRemaining","assertThat","equalTo"],"identifiers":["add","testMvBillions","i","counter"],"startLine":116,"startLineOffset":4,"endLine":143,"endLineOffset":5,"length":1257,"subs":[]},{"id":"x-pack/plugin/esql/compute/src/test/java/org/elasticsearch/compute/aggregation/blockhash/AddPageTests.java-DST-ADDITION-7117-7460-TypeDeclaration","path":"x-pack/plugin/esql/compute/src/test/java/org/elasticsearch/compute/aggregation/blockhash/AddPageTests.java","srcDst":"DST","content":"private class CountingAddInput implements GroupingAggregatorFunction.AddInput {\n        private int count;\n\n        @Override\n        public void add(int positionOffset, IntBlock groupIds) {\n            count++;\n        }\n\n        @Override\n        public void add(int positionOffset, IntVector groupIds) {\n            count++;\n        }\n    }","nodeType":"ADDITION","treeType":"TypeDeclaration","descendantSimpleNames":["CountingAddInput","count","Override","add","positionOffset","IntBlock","groupIds","count","Override","add","positionOffset","IntVector","groupIds","count"],"identifiers":["add","groupIds","count","CountingAddInput","positionOffset"],"startLine":181,"startLineOffset":4,"endLine":193,"endLineOffset":5,"length":344,"subs":[]}]},{"comment":"The test class and method names have been updated from `AddBlockTests` to `AddPageTest