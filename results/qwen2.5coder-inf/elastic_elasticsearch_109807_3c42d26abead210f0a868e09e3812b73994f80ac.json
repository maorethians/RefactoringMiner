bute\u003e results \u003d new ArrayList\u003c\u003e(lhs.size() + rhs.size());\n\n        for (Attribute a : lhs) {\n            if (rhs.contains(a) \u003d\u003d false || matchFields.stream().anyMatch(m -\u003e m.name().equals(a.name()))) {\n                results.add(a);\n            }\n        }\n        for (Attribute a : rhs) {\n            if (false \u003d\u003d matchFields.stream().anyMatch(m -\u003e m.name().equals(a.name()))) {\n                results.add(a);\n            }\n        }\n        return results;\n    }","nodeType":"DELETION","treeType":"MethodDeclaration","descendantSimpleNames":["JoinConfig","matchFields","List","Attribute","mergeOutput","List","Attribute","lhs","List","Attribute","rhs","List","NamedExpression","matchFields","List","Attribute","results","ArrayList","lhs","size","rhs","size","Attribute","a","lhs","rhs","contains","a","matchFields","stream","anyMatch","m","m","name","equals","a","name","results","add","a","Attribute","a","rhs","matchFields","stream","anyMatch","m","m","name","equals","a","name","results","add","a","results"],"identifiers":["a","matchFields","lhs","rhs","results","mergeOutput"],"startLine":90,"startLineOffset":4,"endLine":112,"endLineOffset":5,"length":826,"subs":[]}]},{"comment":"The removal of `matchFields` from `Lookup` class requires careful verification to ensure that all functionalities relying on `matchFields` are now correctly handled through other means, such as `joinConfig()`.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/Lookup.java-SRC-DELETION-4866-4877-SimpleName","path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/Lookup.java","srcDst":"SRC","content":"matchFields","nodeType":"DELETION","treeType":"SimpleName","descendantSimpleNames":["matchFields"],"startLine":128,"startLineOffset":71,"endLine":128,"endLineOffset":82,"length":12,"subs":[]}]}],"groundTruthGeneratedCommentsNodes":[{"groundTruth":{"original_line":93,"start_