 only ever append blocks, so the output pages actually still contain the blocks corresponding to shadowed attributes."],"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/physical/LookupJoinExec.java","id":36728,"created_at":"2024-12-10T10:51:47Z","original_position":9,"side":"RIGHT","position":9,"original_start_line":96,"submitted_on_commit":"d3b3dc627eaf45d3a255b1e3e5293fc31b395231","diff_hunk":"@@ -93,9 +93,9 @@ public List\u003cAttribute\u003e addedFields() {\n     public List\u003cAttribute\u003e output() {\n         if (lazyOutput \u003d\u003d null) {\n             lazyOutput \u003d new ArrayList\u003c\u003e(left().output());\n-            for (Attribute attr : addedFields) {\n-                lazyOutput.add(attr);\n-            }\n+            var addedFieldsNames \u003d addedFields.stream().map(Attribute::name).toList();\n+            lazyOutput.removeIf(a -\u003e addedFieldsNames.contains(a.name()));\n+            lazyOutput.addAll(addedFields);","submitted_start_line":96,"submitted_line":98},"generatedCommentsNodes":[]}],"coveredGroundTruth":0,"uncoveredGroundTruth":1,"coveredHunkNodes":57,"uncoveredHunkNodes":77,"timing":147879,"tokensIn":30708,"tokensOut":1699}