c/main/java/org/elasticsearch/xpack/esql/core/expression/Attribute.java","srcChanges":[],"dstChanges":[{"pos":2061,"endPos":2298,"startLine":52,"startLineOffset":4,"endLine":55,"endLineOffset":5,"length":238}]}]},{"comment":"The introduction of `Failures depFailures` and the subsequent check for failures at the end of the `verify` method could lead to multiple exceptions being thrown if there are multiple issues. Consider aggregating all failures and throwing a single exception that includes all failure messages.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/PhysicalVerifier.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/PhysicalVerifier.java-1334:1353,1366:1409-1415:1453,1499:1722,2378:2421,2443:2554","promptId":"#G82SV","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/PhysicalVerifier.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/optimizer/PhysicalVerifier.java","srcChanges":[{"pos":1334,"endPos":1353,"startLine":36,"startLineOffset":12,"endLine":36,"endLineOffset":31,"length":20},{"pos":1366,"endPos":1409,"startLine":37,"startLineOffset":12,"endLine":37,"endLineOffset":55,"length":44}],"dstChanges":[{"pos":1415,"endPos":1453,"startLine":36,"startLineOffset":8,"endLine":36,"endLineOffset":46,"length":39},{"pos":1499,"endPos":1722,"startLine":39,"startLineOffset":12,"endLine":43,"endLineOffset":13,"length":224},{"pos":2378,"endPos":2421,"startLine":57,"startLineOffset":12,"endLine":57,"endLineOffset":55,"length":44},{"pos":2443,"endPos":2554,"startLine":60,"startLineOffset":8,"endLine":62,"endLineOffset":9,"length":112}]}]}],"groundTruthGeneratedCommentsNodes":[{"groundTruth":{"original_line":98,"start_side":"RIGHT","start_line":96,"line":98,"comment_lines":["[][96]","[][97]","[][98]"],"review_comment":["Oh, this is very interesting. Thanks for catching this.\r\n\r\nI\u0027m wondering if enforcing unique names for `PhysicalPlan` outputs is actually the right way to go. It is what we assumed so far, so I don\u0027t wanna depart from here, but there\u0027s also a reason to be more lenient:\r\n\r\nIn PhysicalPlan land, this output method was _technically_ correct, because it represented exactly what the physical operators will do: they\u0027re gonna append the blocks for the added fields to the pages that are processed. The blocks corresponding to shadowed attributes/channels will _not_ be stripped from incoming pages.\r\n\r\nThis means that the output layout technically has duplicate attribute names. This change just hides them and makes them inaccessible during the physical planning stage.\r\n\r\nFWIW, `EvalExec` has the exact same situation. `Eval` performs shadowing, but `EvalOperator` can only ever append blocks, so the output pages actually still contain the blocks corresponding to shadowed attributes."],"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/physical/LookupJoinExec.java","id":36728,"created_at":"2024-12-10T10:51:47Z","original_position":9,"side":"RIGHT","position":9,"original_start_line":96,"submitted_on_commit":"d3b3dc627eaf45d3a255b1e3e5293fc31b395231","diff_hunk":"@@ -93,9 +93,9 @@ public List\u003cAttribute\u003e addedFields() {\n     public List\u003cAttribute\u003e output() {\n         if (lazyOutput \u003d\u003d null) {\n             lazyOutput \u003d new ArrayList\u003c\u003e(left().output());\n-            for (Attribute attr : addedFields) {\n-                lazyOutput.add(attr);\n-            }\n+            var addedFieldsNames \u003d addedFields.stream().map(Attribute::name).toList();\n+            lazyOutput.removeIf(a -\u003e addedFieldsNames.contains(a.name()));\n+            lazyOutput.addAll(addedFields);","submitted_start_line":96,"submitted_line":98},"generatedCommentsNodes":[{"comment":"The removal of attributes from `lazyOutput` before adding `addedFields` could lead to unexpected behavior if there are duplicate attribute names. Ensure that this change does not introduce any issues with attribute duplication or missing references.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/physical/LookupJoinExec.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/physical/LookupJoinExec.java-3425:3513-3425:3499,3512:3574,3587:3618","promptId":"#1NCJM","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/physical/LookupJoinExec.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/physical/LookupJoinExec.java","srcChanges":[{"pos":3425,"endPos":3513,"startLine":96,"startLineOffset":12,"endLine":98,"endLineOffset":13,"length":89}],"dstChanges":[{"pos":3425,"endPos":3499,"startLine":96,"startLineOffset":12,"endLine":96,"endLineOffset":86,"length":75},{"pos":3512,"endPos":3574,"startLine":97,"startLineOffset":12,"endLine":97,"endLineOffset":74,"length":63},{"pos":3587,"endPos":3618,"startLine":98,"startLineOffset":12,"endLine":98,"endLineOffset":43,"length":32}]}]}]}],"coveredGroundTruth":1,"uncoveredGroundTruth":0,"coveredMatchable":30,"uncoveredMatchable":12,"timing":105455,"tokensIn":12262,"tokensOut":1902}