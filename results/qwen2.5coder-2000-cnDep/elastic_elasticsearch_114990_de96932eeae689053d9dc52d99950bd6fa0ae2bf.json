ryBuilderTests.java","dstPath":"server/src/test/java/org/elasticsearch/index/query/WildcardQueryBuilderTests.java","srcChanges":[],"dstChanges":[{"pos":8152,"endPos":8904,"startLine":188,"startLineOffset":4,"endLine":202,"endLineOffset":5,"length":753}]}]},{"comment":"The test cases for `QueryRewriteContext.getTierPreference` cover various scenarios, including missing tier preference and coordinator rewrite context. However, consider adding a test case where the tier preference setting contains multiple tiers but none match the expected value.","nodes":[{"id":"-server/src/test/java/org/elasticsearch/index/query/QueryRewriteContextTests.java--1093:5018","promptId":"#3ENQQ","dstPath":"server/src/test/java/org/elasticsearch/index/query/QueryRewriteContextTests.java","srcChanges":[],"dstChanges":[{"pos":1093,"endPos":5018,"startLine":27,"startLineOffset":0,"endLine":131,"endLineOffset":1,"length":3926}]}]}],"groundTruthGeneratedCommentsNodes":[{"groundTruth":{"original_line":426,"line":421,"comment_lines":["[][421]"],"review_comment":["I find it surprising that how we read the index setting here differs from how we read it above in CoordinatorRewriteContextProvider. Why is that? Reading the tier from index settings should require the same logic in those two places?","We\u0027ve had performance issues in the past with parsing the tier preference from the settings. We now have a version of the `IndexMetadata` that does the parsing and caches the result for the lifetime of the `IndexMetadata`. \r\nSince the `CoordinatorRewriteContextProvider` has access to the `IndexMetadata` I preferred to take this route rather than re-parsing the setting."],"path":"server/src/main/java/org/elasticsearch/index/query/QueryRewriteContext.java","id":35578,"created_at":"2024-10-23T18:58:26Z","original_position":30,"side":"RIGHT","position":25,"submitted_on_commit":"de96932eeae689053d9dc52d99950bd6fa0ae2bf","diff_hunk":"@@ -407,4 +410,27 @@ public ResolvedIndices getResolvedIndices() {\n     public PointInTimeBuilder getPointInTimeBuilder() {\n         return pit;\n     }\n+\n+    /**\n+     * Retrieve the first tier preference from the index setting. If the setting is not\n+     * present, then return null.\n+     */\n+    @Nullable\n+    public static String getTierPreference(QueryRewriteContext context) {\n+        if (context instanceof CoordinatorRewriteContext) {\n+            String tier \u003d ((CoordinatorRewriteContext) context).tier();\n+            // dominant branch first (tier preference is configured)\n+            return tier.isEmpty() \u003d\u003d false ? tier : null;\n+        }\n+        Settings settings \u003d context.getIndexSettings().getSettings();\n+        String value \u003d DataTier.TIER_PREFERENCE_SETTING.get(settings);","submitted_line":426},"generatedCommentsNodes":[{"comment":"The `getTierPreference` method now checks if the context is an instance of `CoordinatorRewriteContext`. This introduces a dependency on the concrete class, which could be avoided by using polymorphism. Consider adding a method to `QueryRewriteContext` that returns the tier preference and override it in `CoordinatorRewriteContext`.","nodes":[{"id":"server/src/main/java/org/elasticsearch/index/query/QueryRewriteContext.java-server/src/main/java/org/elasticsearch/index/query/QueryRewriteContext.java--16060:17012","promptId":"#6D1Y9","srcPath":"server/src/main/java/org/elasticsearch/index/query/QueryRewriteContext.java","dstPath":"server/src/main/java/org/elasticsearch/index/query/QueryRewriteContext.java","srcChanges":[],"dstChanges":[{"pos":16060,"endPos":17012,"startLine":414,"startLineOffset":4,"endLine":435,"endLineOffset":5,"length":953}]}]}]},{"groundTruth":{"original_line":60,"line":60,"comment_lines":["[][60]"],"review_comment":["perhaps make it super clear that the range info will only have a value for read only indices, because those are the only indices for which that info is populated in the cluster state","I believe read-only indices is a superset of where we actually have this optimization available - i.e. only for fully and partially mounted indices ?\r\nI believe the comment is accurate if my assumption is correct (i.e. hot/warm indices don\u0027t have this optimization, cold/frozen ones - fully/partially mounted ones - do) but happy to clarify further if you have a better suggestion? "],"path":"server/src/main/java/org/elasticsearch/index/query/CoordinatorRewriteContextProvider.java","id":35577,"created_at":"2024-10-23T18:56:25Z","original_position":9,"side":"RIGHT","position":9,"submitted_on_commit":"de96932eeae689053d9dc52d99950bd6fa0ae2bf","diff_hunk":"@@ -52,6 +52,12 @@ public CoordinatorRewriteContext getCoordinatorRewriteContext(Index index) {\n             return null;\n         }\n         DateFieldRangeInfo dateFieldRangeInfo \u003d mappingSupplier.apply(index);\n+        // we\u0027ve now added a coordinator rewrite based on the _tier field so the requirement\n+        // for the timestamps fields to be present is artificial (we could do a coordinator\n+        // rewrite only based on the _tier field) and we might decide to remove this artificial\n+        // limitation to enable coordinator rewrites based on _tier for hot and warm indices\n+        // (currently the _tier coordinator rewrite is only available for mounted and partially mounted\n+        // indices)","submitted_line":60},"generatedCommentsNodes":[]}],"coveredGroundTruth":1,"uncoveredGroundTruth":1,"coveredMatchable":28,"uncoveredMatchable":30,"timing":90708,"tokensIn":22058,"tokensOut":1251}