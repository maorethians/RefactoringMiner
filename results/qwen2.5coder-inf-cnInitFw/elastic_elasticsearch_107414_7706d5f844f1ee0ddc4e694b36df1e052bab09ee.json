     \\_ExchangeExec[[count{r}#18, seen{r}#19, count{r}#20, seen{r}#21],true]\n-     *       \\_EsStatsQueryExec[test], stats[Stat[name\u003d*, type\u003dCOUNT, query\u003dnull], Stat[name\u003d*, type\u003dCOUNT, query\u003dnull]]],\n-     *         query[{\"esql_single_value\":{\"field\":\"emp_no\",\"next\":{\"range\":{\"emp_no\":{\"gt\":10010,\"boost\":1.0}}},\n-     *         \"source\":\"emp_no \u003e 10010@2:9\"}}][count{r}#23, seen{r}#24, count{r}#25, seen{r}#26], limit[],","submitted_start_line":379,"submitted_line":381},"generatedCommentsNodes":[]}],"coveredGroundTruth":0,"uncoveredGroundTruth":1,"coveredMatchable":14,"uncoveredMatchable":22,"timing":91738,"tokensIn":18045,"tokensOut":985}