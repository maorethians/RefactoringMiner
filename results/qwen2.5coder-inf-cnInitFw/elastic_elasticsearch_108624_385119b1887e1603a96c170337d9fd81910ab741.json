","srcChanges":[],"dstChanges":[{"pos":27545,"endPos":27570,"startLine":640,"startLineOffset":8,"endLine":640,"endLineOffset":33,"length":26}]},{"id":"x-pack/plugin/ml/qa/native-multi-node-tests/src/javaRestTest/java/org/elasticsearch/xpack/ml/integration/DatafeedJobsRestIT.java-x-pack/plugin/ml/qa/native-multi-node-tests/src/javaRestTest/java/org/elasticsearch/xpack/ml/integration/DatafeedJobsRestIT.java--57853:57878","promptId":"#KBS17","srcPath":"x-pack/plugin/ml/qa/native-multi-node-tests/src/javaRestTest/java/org/elasticsearch/xpack/ml/integration/DatafeedJobsRestIT.java","dstPath":"x-pack/plugin/ml/qa/native-multi-node-tests/src/javaRestTest/java/org/elasticsearch/xpack/ml/integration/DatafeedJobsRestIT.java","srcChanges":[],"dstChanges":[{"pos":57853,"endPos":57878,"startLine":1356,"startLineOffset":8,"endLine":1356,"endLineOffset":33,"length":26}]}]},{"comment":"The method `findNumberOfRollupJobs` is extracted correctly from `masterOperation`, but the naming could be more descriptive to indicate that it counts rollup jobs in the cluster state. Consider renaming it to `countRollupJobsInClusterState`.","nodes":[{"id":"x-pack/plugin/rollup/src/main/java/org/elasticsearch/xpack/rollup/action/RollupUsageTransportAction.java-x-pack/plugin/rollup/src/main/java/org/elasticsearch/xpack/rollup/action/RollupUsageTransportAction.java-2069:2096,2105:2213,2222:2366-2069:2124","promptId":"#JA7TY","srcPath":"x-pack/plugin/rollup/src/main/java/org/elasticsearch/xpack/rollup/action/RollupUsageTransportAction.java","dstPath":"x-pack/plugin/rollup/src/main/java/org/elasticsearch/xpack/rollup/action/RollupUsageTransportAction.java","srcChanges":[{"pos":2069,"endPos":2096,"startLine":54,"startLineOffset":8,"endLine":54,"endLineOffset":35,"length":28},{"pos":2105,"endPos":2213,"startLine":55,"startLineOffset":8,"endLine":55,"endLineOffset":116,"length":109},{"pos":2222,"endPos":2366,"startLine":56,"startLineOffset":8,"endLine":58,"endLineOffset":9,"length":145}],"dstChanges":[{"po