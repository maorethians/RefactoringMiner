nullability is managed introduces technical debt and potential bugs if `mergeOutputAttributes` does not fully replace the logic of `merge` and `makeNullable`.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/join/Join.java-SRC-DELETION-4404-5063-MethodDeclaration","path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/join/Join.java","srcDst":"SRC","content":"/**\n     * Merge the two lists of attributes into one and preserves order.\n     */\n    private static List\u003cAttribute\u003e merge(List\u003cAttribute\u003e left, List\u003cAttribute\u003e right) {\n        // use linked hash map to preserve order\n        Map\u003cString, Attribute\u003e nameToAttribute \u003d Maps.newLinkedHashMapWithExpectedSize(left.size() + right.size());\n        for (Attribute a : left) {\n            nameToAttribute.put(a.name(), a);\n        }\n        for (Attribute a : right) {\n            // override the existing entry in place\n            nameToAttribute.compute(a.name(), (name, existing) -\u003e a);\n        }\n\n        return new ArrayList\u003c\u003e(nameToAttribute.values());\n    }","nodeType":"DELETION","treeType":"MethodDeclaration","descendantSimpleNames":["List","Attribute","merge","List","Attribute","left","List","Attribute","right","Map","String","Attribute","nameToAttribute","Maps","newLinkedHashMapWithExpectedSize","left","size","right","size","Attribute","a","left","nameToAttribute","put","a","name","a","Attribute","a","right","nameToAttribute","compute","a","name","name","existing","a","ArrayList","nameToAttribute","values"],"identifiers":["a","existing","left","merge","name","right","nameToAttribute"],"startLine":124,"startLineOffset":4,"endLine":139,"endLineOffset":5,"length":660,"subs":[]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/join/Join.java-SRC-DELETION-6071-6333-MethodDeclaration","path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/x