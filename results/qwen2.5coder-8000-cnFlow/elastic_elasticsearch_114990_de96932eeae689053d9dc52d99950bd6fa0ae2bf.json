ot and warm indices\n+        // (currently the _tier coordinator rewrite is only available for mounted and partially mounted\n+        // indices)","submitted_line":60},"generatedCommentsNodes":[{"comment":"In `#4CFJ5`, the check `indexMetadata.getTierPreference().isEmpty() \u003d\u003d false ? indexMetadata.getTierPreference().getFirst() : \"\"` could be simplified and made more robust by checking if `tierPreference` is null before calling `isEmpty()` on it.","nodes":[{"id":"server/src/main/java/org/elasticsearch/index/query/CoordinatorRewriteContextProvider.java-server/src/main/java/org/elasticsearch/index/query/CoordinatorRewriteContextProvider.java--2221:2305,2314:2397,2406:2493,2502:2586,2595:2690,2699:2710,4069:4173","promptId":"#4CFJ5","srcPath":"server/src/main/java/org/elasticsearch/index/query/CoordinatorRewriteContextProvider.java","dstPath":"server/src/main/java/org/elasticsearch/index/query/CoordinatorRewriteContextProvider.java","srcChanges":[],"dstChanges":[{"pos":2221,"endPos":2305,"startLine":55,"startLineOffset":8,"endLine":55,"endLineOffset":92,"length":85},{"pos":2314,"endPos":2397,"startLine":56,"startLineOffset":8,"endLine":56,"endLineOffset":91,"length":84},{"pos":2406,"endPos":2493,"startLine":57,"startLineOffset":8,"endLine":57,"endLineOffset":95,"length":88},{"pos":2502,"endPos":2586,"startLine":58,"startLineOffset":8,"endLine":58,"endLineOffset":92,"length":85},{"pos":2595,"endPos":2690,"startLine":59,"startLineOffset":8,"endLine":59,"endLineOffset":103,"length":96},{"pos":2699,"endPos":2710,"startLine":60,"startLineOffset":8,"endLine":60,"endLineOffset":19,"length":12},{"pos":4069,"endPos":4173,"startLine":84,"startLineOffset":12,"endLine":84,"endLineOffset":116,"length":105}]},{"id":"-server/src/test/java/org/elasticsearch/index/query/QueryRewriteContextTests.java--0:467,1093:5018","promptId":"#FDFVF","dstPath":"server/src/test/java/org/elasticsearch/index/query/QueryRewriteContextTests.java","srcChanges":[],"dstChanges":[{"pos":0,"endP