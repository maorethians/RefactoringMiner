ts with non-null limits are serialized. Setting the `limit` to `null` in these places might lead to unexpected behavior if `null` is not properly handled elsewhere in the code. Ensure that all parts of the system can gracefully handle a `null` limit. The use of `null` for the `limit` parameter suggests that this field is optional. Consider adding validation or defaulting to a specific value if `null` is not intended to be a valid state.","nodes":[{"id":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/plan/logical/MvExpandSerializationTests.java-x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/plan/logical/MvExpandSerializationTests.java--1154:1158","promptId":"#S4W0R","srcPath":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/plan/logical/MvExpandSerializationTests.java","dstPath":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/plan/logical/MvExpandSerializationTests.java","srcChanges":[],"dstChanges":[{"pos":1154,"endPos":1158,"startLine":25,"startLineOffset":61,"endLine":25,"endLineOffset":65,"length":5}]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/planner/Mapper.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/planner/Mapper.java-10474:10572-10638:10759,10772:10968,10988:10994","promptId":"#EMHVE","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/planner/Mapper.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/planner/Mapper.java","srcChanges":[{"pos":10474,"endPos":10572,"startLine":231,"startLineOffset":19,"endLine":231,"endLineOffset":117,"length":99}],"dstChanges":[{"pos":10638,"endPos":10759,"startLine":234,"startLineOffset":12,"endLine":234,"endLineOffset":133,"length":122},{"pos":10772,"endPos":10968,"startLine":235,"startLineOffset":12,"endLine":237,"endLineOffset":13,"length":197},{"pos":10988,"endPos":10994,"startLine":238,"startLineOffset":19,"endLine":238,"endLineOffset":25,"length":7}]},{"id":"x-pack/