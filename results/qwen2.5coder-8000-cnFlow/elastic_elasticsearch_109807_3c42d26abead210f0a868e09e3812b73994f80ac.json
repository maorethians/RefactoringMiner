lable\n-                mergeOutput(makeNullable(left().output()), right, config.matchFields());\n-            case FULL -\u003e // both sides become nullable\n-                mergeOutput(makeNullable(left().output()), makeNullable(right), config.matchFields());\n-            default -\u003e // neither side becomes nullable\n-                mergeOutput(left().output(), right, config.matchFields());\n+            case LEFT -\u003e {\n+                // Right side becomes nullable.\n+                List\u003cAttribute\u003e fieldsAddedFromRight \u003d removeCollisionsWithMatchFields(rightOutput, matchFieldSet, matchFieldNames);\n+                yield mergeOutputAttributes(makeNullable(makeReference(fieldsAddedFromRight)), leftOutput);","submitted_start_line":92,"submitted_line":93},"generatedCommentsNodes":[{"comment":"The method `removeCollisionsWithMatchFields` filters attributes based on whether they are in `matchFields` or not. However, the logic seems inverted for `matchFieldNames.contains(attr.name())`. The condition should be `matchFieldNames.contains(attr.name()) \u003d\u003d true` to exclude attributes that have names matching any of the match fields.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/join/Join.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/join/Join.java--3855:4176","promptId":"#KE21C","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/join/Join.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/join/Join.java","srcChanges":[],"dstChanges":[{"pos":3855,"endPos":4176,"startLine":99,"startLineOffset":4,"endLine":105,"endLineOffset":5,"length":322}]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/join/Join.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/join/Join.java-2616:2623,2666:2722,2788:2818,2835:2907,2920:2933,2934:2963