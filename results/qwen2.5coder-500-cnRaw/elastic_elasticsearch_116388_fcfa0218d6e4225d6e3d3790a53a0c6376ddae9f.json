sions.java--15287:15375","promptId":"#HWRPW","srcPath":"server/src/main/java/org/elasticsearch/TransportVersions.java","dstPath":"server/src/main/java/org/elasticsearch/TransportVersions.java","srcChanges":[],"dstChanges":[{"pos":15287,"endPos":15375,"startLine":212,"startLineOffset":4,"endLine":212,"endLineOffset":92,"length":89}]},{"id":"x-pack/plugin/eql/qa/common/src/main/java/org/elasticsearch/test/eql/BaseEqlSpecTestCase.java-x-pack/plugin/eql/qa/common/src/main/java/org/elasticsearch/test/eql/BaseEqlSpecTestCase.java--5715:5823,6154:6285","promptId":"#N4PYJ","srcPath":"x-pack/plugin/eql/qa/common/src/main/java/org/elasticsearch/test/eql/BaseEqlSpecTestCase.java","dstPath":"x-pack/plugin/eql/qa/common/src/main/java/org/elasticsearch/test/eql/BaseEqlSpecTestCase.java","srcChanges":[],"dstChanges":[{"pos":5715,"endPos":5823,"startLine":166,"startLineOffset":8,"endLine":168,"endLineOffset":9,"length":109},{"pos":6154,"endPos":6285,"startLine":176,"startLineOffset":8,"endLine":178,"endLineOffset":9,"length":132}]}]},{"comment":"The changes in these diffs add `results.shardFailures()` as a new argument to the `EqlSearchResponse` constructor. Ensure that all constructors of `EqlSearchResponse` are updated consistently to handle this new parameter and that existing callsites are also updated accordingly.","nodes":[{"id":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/TransportEqlSearchAction.java-x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/TransportEqlSearchAction.java--11827:11850","promptId":"#4NH26","srcPath":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/TransportEqlSearchAction.java","dstPath":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/TransportEqlSearchAction.java","srcChanges":[],"dstChanges":[{"pos":11827,"endPos":11850,"startLine":279,"startLineOffset":16,"endLine":279,"endLineOffset":39,"length":24}]},{"id":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/TransportEqlSearchAction.java-x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/TransportEqlSearchAction.java--11982:12005","promptId":"#TM3MF","srcPath":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/TransportEqlSearchAction.java","dstPath":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/TransportEqlSearchAction.java","srcChanges":[],"dstChanges":[{"pos":11982,"endPos":12005,"startLine":282,"startLineOffset":99,"endLine":282,"endLineOffset":122,"length":24}]}]},{"comment":"The logic for determining `allowPartialSearchResults` and `allowPartialSequenceResults` is repeated. Consider extracting this into a helper method to reduce code duplication.","nodes":[{"id":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/TransportEqlSearchAction.java-x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/TransportEqlSearchAction.java--9876:10048,10066:10244","promptId":"#80XWK","srcPath":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/TransportEqlSearchAction.java","dstPath":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/TransportEqlSearchAction.java","srcChanges":[],"dstChanges":[{"pos":9876,"endPos":10048,"startLine":236,"startLineOffset":16,"endLine":238,"endLineOffset":57,"length":173},{"pos":10066,"endPos":10244,"startLine":239,"startLineOffset":16,"endLine":241,"endLineOffset":59,"length":179}]}]}],"groundTruthGeneratedCommentsNodes":[{"groundTruth":{"original_line":75,"line":75,"comment_lines":["[][75]"],"review_comment":["Do we need a setting to tweak the default given it\u0027s a flag exposed at the request level? ","I\u0027m not completely sure tbh (maybe @yctercero has opinions here).\r\nMy thinking is that it could make our life easier on existing deployments, where we have hundreds of EQL rules already configured and we don\u0027t want to change them one by one, but maybe this can be addressed at higher level (in Kibana?).\r\n","@luigidellaquila is the discussion here about whether the partial results should be set to default true?\r\n\r\nI think it would make sense for them both be default to off and then at the Kibana level we can expose it as an advanced setting?\r\n\r\n@marshallmain @MikePaquette @approksiu what do you think?","Yes, all the defaults are to `false` now.\r\nThe discussion here was more about the real need for a cluster setting to change these defaults, since we can always set these values per query.","I\u0027m with @javanna here. If there is no need for this, let\u0027s not make it more complicated than it should be. If there will be a desire in the future for this, we can add it.\r\n\r\nThe basic principle of **\"it\u0027s easy to put stuff in, harder to take it out\"** (think about BWC) applies here.\r\n\r\nSame principle for having this as both **request parameter** and **request body parameter**: it complicates the logic unnecessarily and confuses users with a lot of options to think and reason about. I realize that ES query DSL has this in the same way (both **request parameter** and **request body parameter**) and I am not against this that much, but unless there is an actual need and request I wouldn\u0027t confuse users.","@yctercero I remember we discussed this off-line as an option, but I\u0027m not sure if you are actually planning to use these two cluster settings.\r\nShould we keep them?","Let\u0027s go with the less complicated option where we would handle it on the Kibana side - say an advanced setting or something of the like. \r\n\r\ncc @approksiu "],"path":"x-pack/plugin/eql/src/main/java/org/elasticsearch/xpack/eql/plugin/EqlPlugin.java","id":36776,"created_at":"2024-11-27T08:21:13Z","original_position":16,"side":"RIGHT","position":16,"submitted_on_commit":"fcfa0218d6e4225d6e3d3790a53a0c6376ddae9f","diff_hunk":"@@ -60,6 +60,20 @@ public class EqlPlugin extends Plugin implements ActionPlugin, CircuitBreakerPlu\n         Setting.Property.DeprecatedWarning\n     );\n \n+    public static final Setting\u003cBoolean\u003e DEFAULT_ALLOW_PARTIAL_SEARCH_RESULTS \u003d Setting.boolSetting(\n+        \"xpack.eql.default_allow_partial_results\",\n+        false,\n+        Setting.Property.NodeScope,\n+        Setting.Property.Dynamic\n+    );\n+\n+    public static final Setting\u003cBoolean\u003e DEFAULT_ALLOW_PARTIAL_SEQUENCE_RESULTS \u003d Setting.boolSetting(\n+        \"xpack.eql.default_allow_partial_sequence_results\",\n+        false,\n+        Setting.Property.NodeScope,\n+        Setting.Property.Dynamic\n+    );","submitted_line":75},"generatedCommentsNodes":[]}],"coveredGroundTruth":0,"uncoveredGroundTruth":1,"coveredMatchable":38,"uncoveredMatchable":91,"timing":295747,"tokensIn":83887,"tokensOut":7847}