itical bit here is normalization so count(*), count(1), count(), count(*) and count(1+1+2) all fold back to the same expression of count(1)."],"path":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/optimizer/LocalPhysicalPlanOptimizerTests.java","id":37859,"created_at":"2024-04-17T10:39:47Z","original_position":21,"side":"LEFT","position":21,"original_start_line":379,"submitted_on_commit":"7706d5f844f1ee0ddc4e694b36df1e052bab09ee","diff_hunk":"@@ -370,42 +370,17 @@ public void testAnotherCountAllWithFilter() {\n         assertThat(expected.toString(), is(esStatsQuery.query().toString()));\n     }\n \n-    /**\n-     * Expected\n-     * ProjectExec[[c{r}#3, c{r}#3 AS call, c_literal{r}#7]]\n-     * \\_LimitExec[1000[INTEGER]]\n-     *   \\_AggregateExec[[],[COUNT([2a][KEYWORD]) AS c, COUNT(1[INTEGER]) AS c_literal],FINAL,null]\n-     *     \\_ExchangeExec[[count{r}#18, seen{r}#19, count{r}#20, seen{r}#21],true]\n-     *       \\_EsStatsQueryExec[test], stats[Stat[name\u003d*, type\u003dCOUNT, query\u003dnull], Stat[name\u003d*, type\u003dCOUNT, query\u003dnull]]],\n-     *         query[{\"esql_single_value\":{\"field\":\"emp_no\",\"next\":{\"range\":{\"emp_no\":{\"gt\":10010,\"boost\":1.0}}},\n-     *         \"source\":\"emp_no \u003e 10010@2:9\"}}][count{r}#23, seen{r}#24, count{r}#25, seen{r}#26], limit[],","submitted_start_line":379,"submitted_line":381},"generatedCommentsNodes":[]}],"coveredGroundTruth":0,"uncoveredGroundTruth":1,"coveredMatchable":23,"uncoveredMatchable":19,"timing":54121,"tokensIn":14429,"tokensOut":1397}