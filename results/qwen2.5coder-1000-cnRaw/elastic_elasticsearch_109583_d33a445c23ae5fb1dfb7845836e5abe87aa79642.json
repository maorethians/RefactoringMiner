      }\n+            }\n+        }\n+        JoinConfig config \u003d new JoinConfig(JoinType.LEFT, groupingAttributes, leftFields, rightFields);\n+        return new Join(source(), child(), local, config);\n+    }\n+\n+    private LocalRelation firstPhaseResultsToLocalRelation(List\u003cAttribute\u003e schema, List\u003cPage\u003e firstPhaseResult) {\n+        // Limit ourselves to 1mb of results similar to LOOKUP for now.\n+        long bytesUsed \u003d firstPhaseResult.stream().mapToLong(Page::ramBytesUsedByBlocks).sum();\n+        if (bytesUsed \u003e ByteSizeValue.ofMb(1).getBytes()) {\n+            throw new IllegalArgumentException(\"first phase result too large [\" + ByteSizeValue.ofBytes(bytesUsed) + \"] \u003e 1mb\");","submitted_line":175},"generatedCommentsNodes":[{"comment":"In the method `firstPhaseResultsToLocalRelation`, the limit of 1MB for the first phase result is hardcoded. Consider making this configurable or documenting why a fixed limit is used.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/InlineStats.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/InlineStats.java--6342:7713","promptId":"#40X92","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/InlineStats.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/InlineStats.java","srcChanges":[],"dstChanges":[{"pos":6342,"endPos":7713,"startLine":171,"startLineOffset":4,"endLine":195,"endLineOffset":5,"length":1372}]}]}]}],"coveredGroundTruth":3,"uncoveredGroundTruth":2,"coveredMatchable":20,"uncoveredMatchable":24,"timing":111046,"tokensIn":35438,"tokensOut":2795}