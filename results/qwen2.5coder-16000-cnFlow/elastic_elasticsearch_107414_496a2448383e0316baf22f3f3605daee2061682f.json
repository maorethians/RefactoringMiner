ineOffset":118,"length":190}]},{"id":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/optimizer/LogicalPlanOptimizerTests.java-x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/optimizer/LogicalPlanOptimizerTests.java--147120:150829","promptId":"#E2FM7","srcPath":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/optimizer/LogicalPlanOptimizerTests.java","dstPath":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/optimizer/LogicalPlanOptimizerTests.java","srcChanges":[],"dstChanges":[{"pos":147120,"endPos":150829,"startLine":3617,"startLineOffset":4,"endLine":3685,"endLineOffset":5,"length":3710}]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/CountDistinct.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/CountDistinct.java--5928:6219","promptId":"#NFBQ1","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/CountDistinct.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/CountDistinct.java","srcChanges":[],"dstChanges":[{"pos":5928,"endPos":6219,"startLine":124,"startLineOffset":4,"endLine":132,"endLineOffset":5,"length":292}]}]}]},{"groundTruth":{"original_line":116,"line":116,"comment_lines":["[][116]"],"review_comment":["Elsewhere in the code we use the convention of Count(1) - let\u0027s apply that here as well.","Hm, I tried to look for other places where `Count(1)` is used, but couldn\u0027t verify this (for ESQL at least).\r\n\r\nParsing `count()` results in `new Count(source, \"*\", KEYWORD)`, we also use the same in `Sum.surrogate()` and the (currently disabled) `NormalizeAggregate` used to replace all `count(literal)` by `count(*)` as well.\r\n\r\nFor consistency, I\u0027d like to stick to `count(*)` here."],"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/aggregate/Count.java","id":37861,"created_at":"2024-04-22T07:13:53Z","original_position":55,"side":"RIGHT","position":55,"submitted_on_commit":"496a2448383e0316baf22f3f3605daee2061682f","diff_hunk":"@@ -87,4 +93,30 @@ public Nullability nullable() {\n     protected TypeResolution resolveType() {\n         return EsqlTypeResolutions.isExact(field(), sourceText(), DEFAULT);\n     }\n+\n+    @Override\n+    public Expression surrogate() {\n+        var s \u003d source();\n+        var field \u003d field();\n+\n+        if (field.foldable()) {\n+            if (field instanceof Literal l) {\n+                if (l.value() !\u003d null \u0026\u0026 (l.value() instanceof List\u003c?\u003e) \u003d\u003d false) {\n+                    // TODO: Normalize COUNT(*), COUNT(), COUNT(\"foobar\"), COUNT(1) as COUNT(*).\n+                    // Does not apply to COUNT([1,2,3])\n+                    // return new Count(s, new Literal(s, StringUtils.WILDCARD, DataTypes.KEYWORD));\n+                    return null;\n+                }\n+            }\n+\n+            // COUNT(const) is equivalent to MV_COUNT(const)*COUNT(*) if const is not null; otherwise COUNT(const) \u003d\u003d 0.\n+            return new Mul(\n+                s,\n+                new Coalesce(s, new MvCount(s, field), List.of(new Literal(s, 0, DataTypes.INTEGER))),\n+                new Count(s, new Literal(s, StringUtils.WILDCARD, DataTypes.KEYWORD))","submitted_line":116},"generatedCommentsNodes":[{"comment":"The logic for handling foldable expressions in the `surrogate` method seems correct but could be improved for clarity and maintainability. Specifically:\n- The comment about normalizing COUNT(*), COUNT(), COUNT(\"foobar\"), COUNT(1) as COUNT(*) is a TODO that should either be addressed or removed if it\u0027s no longer relevant.\n- The logic for handling foldable fields in `Count` and `CountDistinct` could be refactored to avoid code duplication. Consider extracting the common logic into a helper method.\n- In `Count`, the commented-out return statement suggests a potential optimization that should either be implemented or removed if it\u0027s not feasible.","nodes":[{"id":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/optimizer/LogicalPlanOptimizerTests.java-x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/optimizer/LogicalPlanOptimizerTests.java-150972:150977,151013:151232,151243:151258,151269:151284,151295:151310,151899:151925,151938:151976,151989:152046,152059:152147,152160:152203,152216:152278,152291:152340,152353:152396,152409:152471,152484:152533-156031:156250,156270:156288,156357:156370,156397:156416,156443:156462,156489:156508,156536:156634,157221:157268","promptId":"#FSGQH","srcPath":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/optimizer/LogicalPlanOptimizerTests.java","dstPath":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/optimizer/LogicalPlanOptimizerTests.java","srcChanges":[{"pos":150972,"endPos":150977,"startLine":3700,"startLineOffset":19,"endLine":3700,"endLineOffset":24,"length":6},{"pos":151013,"endPos":151232,"startLine":3700,"startLineOffset":60,"endLine":3706,"endLineOffset":19,"length":220},{"pos":151243,"endPos":151258,"startLine":3706,"startLineOffset":30,"endLine":3706,"endLineOffset":45,"length":16},{"pos":151269,"endPos":151284,"startLine":3706,"startLineOffset":56,"endLine":3706,"endLineOffset":71,"length":16},{"pos":151295,"endPos":151310,"startLine":3706,"startLineOffset":82,"endLine":3706,"endLineOffset":97,"length":16},{"pos":151899,"endPos":151925,"startLine":3719,"startLineOffset":12,"endLine":3719,"endLineOffset":38,"length":27},{"pos":151938,"endPos":151976,"startLine":3720,"startLineOffset":12,"endLine":3720,"endLineOffset":50,"length":39},{"pos":151989,"endPos":152046,"startLine":3721,"startLineOffset":12,"endLine":3721,"endLineOffset":69,"length":58},{"pos":152059,"endPos":152147,"startLine":3722,"startLineOffset":12,"endLine":3722,"endLineOffset":100,"length":89},{"p