tLineOffset":12,"endLine":235,"endLineOffset":36,"length":25}]},{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/Case.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/Case.java-8329:8620-","promptId":"#Z090K","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/Case.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/Case.java","srcChanges":[{"pos":8329,"endPos":8620,"startLine":226,"startLineOffset":4,"endLine":235,"endLineOffset":5,"length":292}],"dstChanges":[]}]},{"comment":"The addition of new return types (`cartesian_shape`, `date_nanos`, `geo_shape`) to the `returnType` array is correct, but ensure that these types are properly handled throughout the function and its dependencies.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/Case.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/Case.java--2979:2996,3030:3042,3103:3114","promptId":"#Q91VF","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/Case.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/Case.java","srcChanges":[],"dstChanges":[{"pos":2979,"endPos":2996,"startLine":65,"startLineOffset":12,"endLine":65,"endLineOffset":29,"length":18},{"pos":3030,"endPos":3042,"startLine":67,"startLineOffset":12,"endLine":67,"endLineOffset":24,"length":13},{"pos":3103,"endPos":3114,"startLine":70,"startLineOffset":12,"endLine":70,"endLineOffset":23,"length":12}]}]}],"groundTruthGeneratedCommentsNodes":[{"groundTruth":{"original_line":78,"line":78,"comment_lines":["[][78]"],"review_comment":["- Maybe let\u0027s randomize the booleans and the number of MVs?\r\n- Maybe let\u0027s also consider cases with multiple multivalued conditions, not just one?\r\n- Also maybe let\u0027s add cases where `partiallyFold` can fully fold, and returns the same as `fold`?","The first two I\u0027m doing now. The last one I\u0027ll have a think about. I think I\u0027d like to make a method to test partiallFold inside `CaseTests` so it can use the test cases.\r\n","I\u0027ve added a bunch of cases."],"path":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/CaseExtraTests.java","id":37162,"created_at":"2024-09-03T09:37:46Z","original_position":7,"side":"RIGHT","position":7,"submitted_on_commit":"3164322d8206a1d5773b0f37b1f65860393dea33","diff_hunk":"@@ -72,6 +72,19 @@ public void testPartialFoldDropsFirstFalse() {\n         );\n     }\n \n+    public void testPartialFoldMv() {\n+        Case c \u003d new Case(\n+            Source.synthetic(\"case\"),\n+            new Literal(Source.EMPTY, List.of(true, true), DataType.BOOLEAN),","submitted_line":78},"generatedCommentsNodes":[{"comment":"The new test case `testPartialFoldMv` is added to verify the behavior of partially folding expressions with multi-valued fields. Ensure that this test accurately reflects the expected behavior and covers all relevant scenarios.","nodes":[{"id":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/CaseExtraTests.java-x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/CaseExtraTests.java--3093:3650","promptId":"#9HS9Y","srcPath":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/CaseExtraTests.java","dstPath":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/CaseExtraTests.java","srcChanges":[],"dstChanges":[{"pos":3093,"endPos":3650,"startLine":75,"startLineOffset":4,"endLine":86,"endLineOffset":5,"length":558}]}]}]},{"groundTruth":{"original_line":335,"start_side":"RIGHT","start_line":342,"line":350,"comment_lines":["[][342]","[][343]","[][344]","[][345]","[][346]","[][347]","[][348]","[][349]","[][350]"],"review_comment":["CC @costin and @astefan : Nik is nicely making the MV semantics for CASE consistent.\r\n\r\nJust FYI because we could also choose to define `CASE([true, true], ... ) \u003d\u003d null` similarly to functions, which applied to multivalues just become `null`. I think Nik\u0027s approach is more useful, because making `CASE` on multivalues always return `null` would probably also imply that `CASE(true, a, [true, true], b)` should return `null`, even though it doesn\u0027t matter that the second condition is multivalued.","\u003e I think Nik\u0027s approach is more useful\r\n\r\nIt\u0027s also the same approach as PostgreSQL.","I don\u0027t think Case makes the equivalence of null \u003d\u003d false rather it checks if the condition is true.\r\nThat is  `SELECT CASE WHEN null THEN 1 ELSE 2 END` returns 2 because the condition `null` is not true. \r\nIt\u0027s a subtle difference but it means `CASE(true, a, [true, true], b)` should return a because the condition is `true` so the else branch is not even evaluated."],"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/Case.java","id":37160,"created_at":"2024-09-03T09:16:04Z","original_position":138,"side":"RIGHT","position":183,"original_start_line":327,"submitted_on_commit":"3164322d8206a1d5773b0f37b1f65860393dea33","diff_hunk":"@@ -303,40 +312,58 @@ public ExpressionEvaluator get(DriverContext context) {\n \n             @Override\n             public String toString() {\n-                return \"CaseEvaluator[resultType\u003d\"\n-                    + resultType\n-                    + \", conditions\u003d\"\n-                    + conditionsFactories\n-                    + \", elseVal\u003d\"\n-                    + elseValueFactory\n-                    + \u0027]\u0027;\n+                return \"CaseEvaluator[conditions\u003d\" + conditionsFactories + \", elseVal\u003d\" + elseValueFactory + \u0027]\u0027;\n             }\n         };\n     }\n \n-    record ConditionEvaluatorSupplier(ExpressionEvaluator.Factory condition, ExpressionEvaluator.Factory value)\n+    record ConditionEvaluatorSupplier(Source conditionSource, ExpressionEvaluator.Factory condition, ExpressionEvaluator.Factory value)\n         implements\n             Function\u003cDriverContext, ConditionEvaluator\u003e {\n         @Override\n         public ConditionEvaluator apply(DriverContext driverContext) {\n-            return new ConditionEvaluator(condition.get(driverContext), value.get(driverContext));\n+            return new ConditionEvaluator(\n+                /*\n+                 * We treat failures as null just like any other failure.\n+                 * It\u0027s just that we then *immediately* convert it to\n+                 * true or false using the tri-valued boolean logic stuff.\n+                 * And that makes it into false. This is, *exactly* what\n+                 * happens in PostgreSQL and MySQL and SQLite:\n+                 * \u003e SELECT CASE WHEN null THEN 1 ELSE 2 END;\n+                 * 2\n+                 * Rather than go into depth about this in the warning message,\n+                 * we just say \"false\".","submitted_start_line":327,"submitted_line":335},"generatedCommentsNodes":[{"comment":"The changes in these diffs introduce a new parameter `first` to the `Warnings` constructor and modify the creation of `Warnings` objects. Ensure that all instances where `Warnings` is instantiated are updated accordingly to provide the new `first` parameter.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/Warnings.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/Warnings.java--1492:2085","promptId