5,"startLineOffset":85,"endLine":2145,"endLineOffset":95,"length":11},{"pos":108207,"endPos":108215,"startLine":2145,"startLineOffset":97,"endLine":2145,"endLineOffset":105,"length":9},{"pos":109483,"endPos":109524,"startLine":2161,"startLineOffset":8,"endLine":2161,"endLineOffset":49,"length":42},{"pos":110213,"endPos":110223,"startLine":2177,"startLineOffset":85,"endLine":2177,"endLineOffset":95,"length":11},{"pos":110225,"endPos":110233,"startLine":2177,"startLineOffset":97,"endLine":2177,"endLineOffset":105,"length":9},{"pos":110321,"endPos":110331,"startLine":2178,"startLineOffset":85,"endLine":2178,"endLineOffset":95,"length":11},{"pos":110333,"endPos":110341,"startLine":2178,"startLineOffset":97,"endLine":2178,"endLineOffset":105,"length":9},{"pos":110682,"endPos":110709,"startLine":2184,"startLineOffset":8,"endLine":2184,"endLineOffset":35,"length":28},{"pos":110718,"endPos":110841,"startLine":2185,"startLineOffset":8,"endLine":2185,"endLineOffset":131,"length":124},{"pos":110850,"endPos":110886,"startLine":2186,"startLineOffset":8,"endLine":2186,"endLineOffset":44,"length":37},{"pos":110895,"endPos":110947,"startLine":2187,"startLineOffset":8,"endLine":2187,"endLineOffset":60,"length":53},{"pos":110956,"endPos":111053,"startLine":2188,"startLineOffset":8,"endLine":2188,"endLineOffset":105,"length":98},{"pos":111062,"endPos":111095,"startLine":2189,"startLineOffset":8,"endLine":2189,"endLineOffset":41,"length":34},{"pos":111104,"endPos":111150,"startLine":2190,"startLineOffset":8,"endLine":2190,"endLineOffset":54,"length":47},{"pos":111159,"endPos":111496,"startLine":2191,"startLineOffset":8,"endLine":2200,"endLineOffset":10,"length":338},{"pos":111505,"endPos":111570,"startLine":2201,"startLineOffset":8,"endLine":2201,"endLineOffset":73,"length":66},{"pos":111579,"endPos":111649,"startLine":2202,"startLineOffset":8,"endLine":2202,"endLineOffset":78,"length":71},{"pos":111658,"endPos":111666,"startLine":2203,"startLineOffset":8,"endLine":2203,"endLineOffset":16,"length":9},{"pos":111675,"endPos":111733,"startLine":2204,"startLineOffset":8,"endLine":2204,"endLineOffset":66,"length":59},{"pos":111742,"endPos":111753,"startLine":2205,"startLineOffset":8,"endLine":2205,"endLineOffset":19,"length":12},{"pos":111762,"endPos":111861,"startLine":2206,"startLineOffset":8,"endLine":2206,"endLineOffset":107,"length":100},{"pos":111870,"endPos":111969,"startLine":2207,"startLineOffset":8,"endLine":2207,"endLineOffset":107,"length":100},{"pos":111978,"endPos":112070,"startLine":2208,"startLineOffset":8,"endLine":2208,"endLineOffset":100,"length":93},{"pos":112079,"endPos":112091,"startLine":2209,"startLineOffset":8,"endLine":2209,"endLineOffset":20,"length":13},{"pos":112100,"endPos":112165,"startLine":2210,"startLineOffset":8,"endLine":2210,"endLineOffset":73,"length":66},{"pos":112174,"endPos":112239,"startLine":2211,"startLineOffset":8,"endLine":2211,"endLineOffset":73,"length":66},{"pos":112248,"endPos":112313,"startLine":2212,"startLineOffset":8,"endLine":2212,"endLineOffset":73,"length":66}]}]}],"groundTruthGeneratedCommentsNodes":[{"groundTruth":{"original_line":2178,"line":2179,"comment_lines":["[][2179]"],"review_comment":["I think it might be more clear here to put `startSize2` as the produced expected value, since the ingested and produced should be the same for failure and drop.","This comment made me aware that there might be a bug around here because I\u0027m not sure these values are actually supposed to be equal, I think it just turns out that way because the mock processors aren\u0027t modifying the data so there\u0027s no increase in bytes.\r\n\r\nBut I dug into this a little bit more and realized I misremembered this part of the test as [this test](https://github.com/elastic/elasticsearch/blob/12b31e79caa67fd717ffa49166eff54e179acca9/server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java#L181) when we brought up testing a failure\r\nAnd I think parts of this test don\u0027t behave the way I thought it did (in the 3rd test the byte stats values for `_id1` hasn\u0027t increased, and in the 4th with the failure `startSize1` is equal to `endSize1`), so I\u0027m going to dig into this a bit more","Figured out what was wrong - when the stats of a pipeline gets updated via another pipeline\u0027s stats it wasn\u0027t updating the `IngestPipelineMetric` stats, so I fixed that and changed some of the tests as necessary","Good catch on figuring out what was going on here, and fixing the `IngestPipelineMetric.add` method.\r\n\r\nAs an aside, I was at first very confused about why the `endSize1` was increasing despite the failure. Also why the `_id1` pipeline has a `failed` count of 0 in the ` assertPipelineStats` call above. I had missed that the failure-mock has an `on_failure` processor defined. When there is an on_failure processor, the resulting document does get sent to the index, so that explains why it is in the bytesProduced stat. (You may have been aware of all this already).","Yeah that was part of what led me to investigating that section, I didn\u0027t realize at first that `endSize1` was increasing there"],"path":"server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java","id":34986,"created_at":"2024-05-13T14:58:50Z","original_position":130,"side":"RIGHT","position":135,"submitted_on_commit":"12b31e79caa67fd717ffa49166eff54e179acca9","diff_hunk":"@@ -2165,12 +2174,43 @@ public void testStats() throws Exception {\n         // total\n         assertStats(afterForthRequestStats.totalStats(), 4, 0, 0);\n         // pipeline\n-        assertPipelineStats(afterForthRequestStats.pipelineStats(), \"_id1\", 3, 0, 0);\n-        assertPipelineStats(afterForthRequestStats.pipelineStats(), \"_id2\", 1, 0, 0);\n+        assertPipelineStats(afterForthRequestStats.pipelineStats(), \"_id1\", 3, 0, 0, startSize1, endSize1);\n+        assertPipelineStats(afterForthRequestStats.pipelineStats(), \"_id2\", 1, 0, 0, startSize2, endSize2);","submitted_line":2178},"generatedCommentsNodes":[{"comment":"The addition of byte stats to the pipeline metrics and assertions in test cases is well-integrated. Ensure that the new fields (`bytesIngested`, `bytesProduced`) are included in all relevant test scenarios, especially those involving pipeline updates and failures. This will help ensure that the new functionality does not introduce regressions.","nodes":[{"id":"server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java-server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java--102681:102731,104331:104376,104805:104848,105347:105357,105359:105367,105455:105456,105458:105459,105682:105727,106157:106200,106472:106482,106484:106492,106581:106591,106593:106601,107309:107350,107779:107818,108087:108097,108099:108107,108195:108205,108207:108215,109483:109524,110213:110223,110225:110233,110321:110331,110333:110341,110682:110709,110718:110841,110850:110886,110895:110947,110956:111053,111062:111095,111104:111150,111159:111496,111505:111570,111579:111649,111658:111666,111675:111733,111742:111753,111762:111861,111870:111969,111978:112070,112079:112091,112100:112165,112174:112239,112248:112313","promptId":"#GS9NC","srcPath":"server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java","dstPath":"server/src/test/java/org/elasticsearch/ingest/IngestServiceTests.java","srcChanges":[],"dstChanges":[{"pos":102681,"endPos":102731,"startLine":2037,"startLineOffset":8,"endLine":2037,"endLineOffset":58,"length":51},{"pos":104331,"endPos":104376,"startLine":2066,"startLineOffset":8,"endLine":2066,"endLineOffset":53,"length":46},{"pos":104805,"endPos":104848,"startLine":2078,"startLineOffset":8,"endLine":2078,"endLineOffset":51,"length":44},{"pos":105347,"endPos":105357,"startLine":2087,"startLineOffset":85,"endLine":2087,"endLineOffset":95,"length":11},{"pos":105359,"endPos":105367,"startLine":2087,"startLineOffset":97,"endLine":2087,"endLineOffset":105,"length":9},{"pos":105455,"endPos":105456,"startLine":2088,"startLineOf