9,"startLineOffset":12,"endLine":461,"endLineOffset":13,"length":1741}],"dstChanges":[]}]},{"comment":"The refactoring of `Case` to separate eager and lazy evaluators is a good improvement. However, the logic in `get` methods could be simplified by extracting common code into helper methods:\n```java\nprivate ExpressionEvaluator createEvaluator(DriverContext context) {\n    List\u003cConditionEvaluator\u003e conditions \u003d new ArrayList\u003c\u003e(conditionsFactories.size());\n    ExpressionEvaluator elseValue \u003d null;\n    try {\n        for (ConditionEvaluatorSupplier cond : conditionsFactories) {\n            conditions.add(cond.apply(context));\n        }\n        elseValue \u003d elseValueFactory.get(context);\n        return createCaseEvaluator(resultType, context.blockFactory(), conditions, elseValue);\n    } finally {\n        Releasables.close(conditions \u003d\u003d null ? () -\u003e {} : Releasables.wrap(conditions), elseValue);\n    }\n}\nprivate ExpressionEvaluator createCaseEvaluator(DataType resultType, BlockFactory blockFactory, List\u003cConditionEvaluator\u003e conditions, ExpressionEvaluator elseVal) {\n    if (conditions.isEmpty()) {\n        return new CaseEagerEvaluator(resultType, blockFactory, null, elseVal);\n    } else {\n        return new CaseLazyEvaluator(blockFactory, resultType, conditions, elseVal);\n    }\n}\n```\nThis reduces code duplication and improves readability.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/Case.java--15457:15539,15624:15760,15923:15933,15923:15933,15963:15973,15963:15973,16105:16165-","promptId":"#C65ET1VR9794","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/expression/function/scalar/conditional/Case.java","srcChanges":[{"pos":15457,"endPos":15539,"startLine":389,"startLineOffset":12,"endLine":389,"endLineOffset":94,"length":83},{"pos":15624,"endPos":15760,"startLine":392,"startLineOffset":16,"endLine":39