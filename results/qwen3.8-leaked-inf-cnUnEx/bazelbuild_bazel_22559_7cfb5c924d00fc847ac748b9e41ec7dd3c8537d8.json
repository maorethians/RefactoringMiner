os":7560,"startLine":177,"startLineOffset":2,"endLine":196,"endLineOffset":3,"length":815}]}]},{"comment":"In #E60YX, the final stash assembly does:\n```java\nmain.dirEntries().put(SandboxStash.getWorkspaceName(), stashContentsMap.get(PathFragment.EMPTY_FRAGMENT));\n```\nIf `inputs.getFiles()` and `inputs.getSymlinks()` are both empty and no output directories exist, `stashContentsMap` will be empty and `get(PathFragment.EMPTY_FRAGMENT)` returns `null`. This `null` is then stored in `dirEntries()`, which will cause an NPE later when `cleanRecursivelyWithInMemoryStashes` (#FBXKT) iterates over `dirEntries()` and calls methods on the value. A null-check or a default `StashContents.create()` should be used.","nodes":[{"id":"src/main/java/com/google/devtools/build/lib/sandbox/SymlinkedSandboxedSpawn.java-src/main/java/com/google/devtools/build/lib/sandbox/SymlinkedSandboxedSpawn.java-2753:2760,2761:2769,2920:2928,2938:3019,3026:3118,3125:3217,3224:3303,3310:3401,3408:3492,3499:3695-3069:3123,3128:3151,3152:3165,3271:3282,3343:3364,3374:4547,4559:6403","promptId":"#E60YX","srcPath":"src/main/java/com/google/devtools/build/lib/sandbox/SymlinkedSandboxedSpawn.java","dstPath":"src/main/java/com/google/devtools/build/lib/sandbox/SymlinkedSandboxedSpawn.java","srcChanges":[{"pos":2753,"endPos":2760,"startLine":77,"startLineOffset":4,"endLine":77,"endLineOffset":11,"length":8},{"pos":2761,"endPos":2769,"startLine":77,"startLineOffset":12,"endLine":77,"endLineOffset":20,"length":9},{"pos":2920,"endPos":2928,"startLine":80,"startLineOffset":8,"endLine":80,"endLineOffset":16,"length":9},{"pos":2938,"endPos":3019,"startLine":81,"startLineOffset":6,"endLine":81,"endLineOffset":87,"length":82},{"pos":3026,"endPos":3118,"startLine":82,"startLineOffset":6,"endLine":82,"endLineOffset":98,"length":93},{"pos":3125,"endPos":3217,"startLine":83,"startLineOffset":6,"endLine":83,"endLineOffset":98,"length":93},{"pos":3224,"endPos":3303,"startLine":84,"startLineOffset":6,"endLine":84,"endLineOffset":85,"length":80},{"pos":3310,"endPos":3401,"startLine":85,"startLineOffset":6,"endLine":85,"endLineOffset":97,"length":92},{"pos":3408,"endPos":3492,"startLine":86,"startLineOffset":6,"endLine":86,"endLineOffset":90,"length":85},{"pos":3499,"endPos":3695,"startLine":87,"startLineOffset":6,"endLine":93,"endLineOffset":23,"length":197}],"dstChanges":[{"pos":3069,"endPos":3123,"startLine":86,"startLineOffset":4,"endLine":88,"endLineOffset":5,"length":55},{"pos":3128,"endPos":3151,"startLine":89,"startLineOffset":4,"endLine":89,"endLineOffset":27,"length":24},{"pos":3152,"endPos":3165,"startLine":89,"startLineOffset":28,"endLine":89,"endLineOffset":41,"length":14},{"pos":3271,"endPos":3282,"startLine":91,"startLineOffset":62,"endLine":91,"endLineOffset":73,"length":12},{"pos":3343,"endPos":3364,"startLine":94,"startLineOffset":8,"endLine":94,"endLineOffset":29,"length":22},{"pos":3374,"endPos":4547,"startLine":95,"startLineOffset":6,"endLine":120,"endLineOffset":7,"length":1174},{"pos":4559,"endPos":6403,"startLine":123,"startLineOffset":4,"endLine":164,"endLineOffset":5,"length":1845}]},{"id":"src/main/java/com/google/devtools/build/lib/sandbox/SandboxHelpers.java-src/main/java/com/google/devtools/build/lib/sandbox/SandboxHelpers.java--8461:11333","promptId":"#FBXKT","srcPath":"src/main/java/com/google/devtools/build/lib/sandbox/SandboxHelpers.java","dstPath":"src/main/java/com/google/devtools/build/lib/sandbox/SandboxHelpers.java","srcChanges":[],"dstChanges":[{"pos":8461,"endPos":11333,"startLine":205,"startLineOffset":2,"endLine":276,"endLineOffset":3,"length":2873}]}]},{"comment":"In #FBXKT, the code does:\n```java\nPreconditions.checkState(inputsToCreate.remove(pathRelativeToWorkDir));\n```\nThe old `cleanRecursively` (shown in the dependency) simply called `inputsToCreate.remove(pathRelativeToWorkDir)` without asserting the result. If a path was already removed from `inputsToCreate` (e.g., by a prior iteration or by `filterInputsAndDirsToCreate`), the new code will throw an `IllegalStateException` where the old code would have silently succeeded. This can cause spurious build failures in edge cases where the same path appears in multiple stash entries or was pre-filtered.","nodes":[{"id":"src/main/java/com/google/devtools/build/lib/sandbox/SandboxHelpers.java-src/main/java/com/google/devtools/build/lib/sandbox/SandboxHelpers.java--8461:11333","promptId":"#FBXKT","srcPath":"src/main/java/com/google/devtools/build/lib/sandbox/SandboxHelpers.java","dstPath":"src/main/java/com/google/devtools/build/lib/sandbox/SandboxHelpers.java","srcChanges":[],"dstChanges":[{"pos":8461,"endPos":11333,"startLine":205,"startLineOffset":2,"endLine":276,"endLineOffset":3,"length":2873}]}]},{"comment":"In #E60YX, the early return `if (!SandboxStash.gotInstance()) { return; }` causes `sandboxExecRoot.createDirectoryAndParents()` to be skipped when `SandboxStash` has not been initialized. In the previous code (visible in the removed lines), `createDirectoryAndParents()` was called unconditionally after `takeStashedSandbox`. This is a behavioral regression: any code path where `SandboxStash` is not yet initialized (e.g., certain test setups, or a misconfigured module) will now fail to create the exec root directory, leading to downstream `IOException`s. The directory creation should be moved before the `gotInstance()` guard, or the guard should only protect the stash-specific logic.","nodes":[{"id":"src/main/java/com/google/devtools/build/lib/sandbox/SymlinkedSandboxedSpawn.java-src/main/java/com/google/devtools/build/lib/sandbox/SymlinkedSandboxedSpawn.java-2753:2760,2761:2769,2920:2928,2938:3019,3026:3118,3125:3217,3224:3303,3310:3401,3408:3492,3499:3695-3069:3123,3128:3151,3152:3165,3271:3282,3343:3364,3374:4547,4559:6403","promptId":"#E60YX","srcPath":"src/main/java/com/google/devtools/build/lib/sandbox/SymlinkedSandboxedSpawn.java","dstPath":"src/main/java/com/google/devtools/build/lib/sandbox/SymlinkedSandboxedSpawn.java","srcChanges":[