n/java/org/elasticsearch/xpack/esql/core/expression/Alias.java","dstPath":"x-pack/plugin/esql-core/src/main/java/org/elasticsearch/xpack/esql/core/expression/Alias.java","srcChanges":[],"dstChanges":[{"pos":4295,"endPos":4467,"startLine":133,"startLineOffset":4,"endLine":136,"endLineOffset":5,"length":173}]}]},{"comment":"The old code embedded `from.dataType().typeName()` into the `UnsupportedEsField`, giving downstream error messages the original type context. The new `UnresolvedAttribute` drops that information entirely (qualifier is `null`, no type name carried). If this attribute is later surfaced in a user-facing error (e.g., \"cannot cast string literal to …\"), the message will be less diagnostic. Consider whether the type name should be preserved in the `unresolvedMessage` string or in some other field.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java-52208:52228,52334:52413-52332:52351,52396:52400","promptId":"#9TBEK","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java","srcChanges":[{"pos":52208,"endPos":52228,"startLine":1070,"startLineOffset":27,"endLine":1070,"endLineOffset":47,"length":21},{"pos":52334,"endPos":52413,"startLine":1073,"startLineOffset":20,"endLine":1073,"endLineOffset":99,"length":80}],"dstChanges":[{"pos":52332,"endPos":52351,"startLine":1071,"startLineOffset":27,"endLine":1071,"endLineOffset":46,"length":20},{"pos":52396,"endPos":52400,"startLine":1071,"startLineOffset":91,"endLine":1071,"endLineOffset":95,"length":5}]}]},{"comment":"Removing the `EsRelation` special-case means `InvalidMappedField` instances inside `EsRelation` will now be converted to `UnsupportedAttribute` by `checkUnresolved`. The old comment explicitly stated this was done \"so that UNSUPPORTED fields can still pass through.\" If any downstream component (e.g., `FieldExtractExec` generation, or the `EsRelation` output-set logic in the same `doRule`) relies on seeing `InvalidMappedField` in the relation, this will break. Verify that no downstream code pattern-matches on `InvalidMappedField` within `EsRelation.output()`.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java-62592:62943-60896:60980","promptId":"#JZAZ5","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java","srcChanges":[{"pos":62592,"endPos":62943,"startLine":1249,"startLineOffset":93,"endLine":1255,"endLineOffset":13,"length":352}],"dstChanges":[{"pos":60896,"endPos":60980,"startLine":1220,"startLineOffset":21,"endLine":1220,"endLineOffset":105,"length":85}]}]},{"comment":"`Expressions.attributeUnchecked()` mirrors `attribute()` but delegates to `toAttributeUnchecked()`. Correct.","nodes":[{"id":"x-pack/plugin/esql-core/src/main/java/org/elasticsearch/xpack/esql/core/expression/Expressions.java-x-pack/plugin/esql-core/src/main/java/org/elasticsearch/xpack/esql/core/expression/Expressions.java--4576:4764","promptId":"#Y3ZFA","srcPath":"x-pack/plugin/esql-core/src/main/java/org/elasticsearch/xpack/esql/core/expression/Expressions.java","dstPath":"x-pack/plugin/esql-core/src/main/java/org/elasticsearch/xpack/esql/core/expression/Expressions.java","srcChanges":[],"dstChanges":[{"pos":4576,"endPos":4764,"startLine":155,"startLineOffset":4,"endLine":160,"endLineOffset":5,"length":189}]}]},{"comment":"Capability registration. No issue.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/action/EsqlCapabilities.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/action/EsqlCapabilities.java--4633:4820","promptId":"#XBP8P","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/action/EsqlCapabilities.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/action/EsqlCapabilities.java","srcChanges":[],"dstChanges":[{"pos":4633,"endPos":4820,"startLine":159,"startLineOffset":8,"endLine":163,"endLineOffset":41,"length":188}]}]},{"comment":"Two observations:\n- The `types` string is built via `imf.getTypesToIndices().keySet().stream().collect(Collectors.joining(\",\"))`. If the map is empty (defensive edge case), `types` will be `\"\"`, producing an `UnsupportedEsField` with an empty `originalType`. A guard or a fallback like `\"unknown\"` would make the error message more robust.\n- The `UnsupportedEsField(String name, String originalType)` constructor is used, which sets the internal `typesToIndices` map to an empty `TreeMap`. The actual per-index type mapping from `imf.getTypesToIndices()` is lost—only the concatenated key names are retained. If any downstream logic inspects the `UnsupportedEsField`\u0027s `typesToIndices` map, it will see an empty map.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java-63577:63596,63621:63635,63637:63644,63665:63669-61616:61706,61734:61754,61840:61884,61945:61952","promptId":"#AD1DN","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java","srcChanges":[{"pos":63577,"endPos":63596,"startLine":1267,"startLineOffset":27,"endLine":1267,"endLineOffset":46,"length":20},{"pos":63621,"endPos":63635,"startLine":1267,"startLineOffset":71,"endLine":1267,"endLineOffset":85,"length":15},{"pos":63637,"endPos":63644,"startLine":1267,"startLineOffset":87,"endLine":1267,"endLineOffset":94,"length":8},{"pos":63665,"endPos":63669,"startLine":1267,"startLineOffset":115,"endLine":1267,"endLineOffset":119,"length":5}],"dstChanges":[{"pos":61616,"endPos":61706,"startLine":1233,"startLineOffset":16,"endLine":1233,"endLineOffset":106,"length":91},{"pos":61734,"endPos":61754,"startLine":1234,"startLineOffset":27,"endLine":1234,"endLineOffset":47,"length":21},{"pos":61840,"endPos":61884,"startLine":1237,"startLineOffset":20,"endLine":1237,"endLineOffset":64,"length":45},{"pos":61945,"endPos":61952,"startLine":1239,"startLineOffset":20,"endLine":1239,"endLineOffset":27,"length":8}]}]},{"comment":"Removal of `resolveAttribute`. Consistent with the removal of the aggregate re-resolution block in #33B14. No issue.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java-x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java-57105:57576-","promptId":"#3D7XF","srcPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java","dstPath":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/analysis/Analyzer.java","srcChanges":[{"pos":57105,"endPos":57576,"startLine":1162,"startLineOffset":8,"endLine":1169,"endLineOffset":9,"length":472}],"dstChanges":[]}]},{"comment":"The switch from `Expressions.attribute(e)` to `Expressions.attributeUnchecked(e)` changes the failure mode for truly unresolved expressions: the old path returned an `UnresolvedAttribute` (filtered out by `attr.resolved()`), while the new path throws `UnresolvedException` (via `UnresolvedNamedExpression.toAttributeUnchecked()`). If any code path can place an `UnresolvedNamedExpression` into `agg.groupings()` at this stage, this is a hard-crash regression. Please confirm that groupings at the `ResolveRefs` stage are guaranteed to be either `Attribute`, `Alias`, or a `FieldAttribute` with a partially-resolved type, and never a bare `UnresolvedNamedExpression`.","nodes":[{"id":"x-pack/plugin/esql/src/main/java/org/elasticsearch/